# -- Dispatch ---------------------------------------------------------------

def cmd_task_create(args):
    """Create a ticket in the Backlog lane (no agent launched)."""
    state_data = get_state(args.port)

    group = args.group
    if not group:
        _cell, _parent, group = detect_context(state_data)
        if not group:
            die("--group (-g) is required\n"
                "  (auto-detect failed — not in a Torque-managed session)")

    kwargs = {
        "task": args.description,
        "group": group,
        "lane": "Backlog",
    }
    if getattr(args, "engineer", None) is not None:
        kwargs["assigned_engineer_id"] = _validate_engineer_assignment(
            state_data, args.engineer, group
        )
    if getattr(args, "context", None):
        kwargs["description"] = args.context
    if args.labels:
        kwargs["labels"] = [l.strip() for l in args.labels.split(",") if l.strip()]
    if getattr(args, "action", None):
        kwargs["action_name"] = args.action
    if getattr(args, "var", None):
        tvars = {}
        for kv in args.var:
            k, _, v = kv.partition("=")
            if k:
                tvars[k] = v
        if tvars:
            kwargs["action_vars"] = tvars
    if getattr(args, "at", None):
        kwargs["scheduled_at"] = _parse_relative_time(args.at)
    if getattr(args, "depends_on", None):
        dep_ids = _resolve_dep_ids(state_data, args.depends_on)
        if dep_ids:
            kwargs["depends_on"] = dep_ids

    resp = api_call("board_add_task", port=args.port, **kwargs)
    check_ok(resp)
    scheduled = " (scheduled)" if kwargs.get("scheduled_at") else ""
    print(f"Task added to Backlog{scheduled}")


def cmd_task_dispatch(args):
    """Create a ticket in In Progress, launch an agent, and link them."""
    state_data = get_state(args.port)

    # Resolve group
    group = args.group
    if not group:
        _cell, _parent, group = detect_context(state_data)
        if not group:
            die("--group (-g) is required\n"
                "  (auto-detect failed — not in a Torque-managed session)")

    # Build variables dict
    variables = {"TASK": args.description}
    if args.var:
        for kv in args.var:
            if "=" not in kv:
                die(f"Invalid variable format: {kv} (expected KEY=VALUE)")
            k, v = kv.split("=", 1)
            variables[k] = v

    # -- Create the ticket first (In Progress lane) --
    ticket_kwargs = {
        "task": args.description,
        "group": group,
        "lane": "In Progress",
    }
    if args.labels:
        ticket_kwargs["labels"] = [l.strip() for l in args.labels.split(",")
                                   if l.strip()]
    if args.action:
        ticket_kwargs["action_name"] = args.action
        # Store non-TASK variables as action_vars
        tvars = {k: v for k, v in variables.items() if k != "TASK"}
        if tvars:
            ticket_kwargs["action_vars"] = tvars

    # -- Launch the agent --
    if args.action:
        # Server-side rendering via add_agent_from_action
        act = load_action(args.action)
        act_agent = act.get("agent", {}) if act else {}
        if args.name:
            agent_name = args.name
        elif act_agent.get("name_prefix"):
            slug = task_slug(args.description)
            agent_name = f"{act_agent['name_prefix']}-{slug}"
        else:
            slug = task_slug(args.description)
            agent_name = slug or "agent"

        kwargs = {
            "group": group,
            "action": args.action,
            "vars": variables,
            "name": agent_name,
        }
        if args.command:
            kwargs["command"] = args.command
        if args.directory:
            kwargs["directory"] = args.directory

        if args.no_task:
            variables.pop("TASK", None)
            kwargs["vars"] = variables

        resp = api_call("add_agent_from_action", port=args.port, **kwargs)
    else:
        # No action — plain add_agent + send_text
        slug = task_slug(args.description)
        agent_name = args.name or slug or "agent"
        kwargs = {"name": agent_name, "group": group}
        if args.command:
            kwargs["command"] = args.command
        if args.directory:
            kwargs["directory"] = args.directory
        resp = api_call("add_agent", port=args.port, **kwargs)

    data = check_ok(resp)

    # Find the new agent in the returned state
    agents = data.get("agents", {})
    match = [c for c in agents.values()
             if c["name"] == agent_name and c["group"] == group]
    if not match:
        die("Agent creation succeeded but could not find it in state")
    cell = match[-1]
    cell_id = cell["id"]

    # Create ticket and link to the agent
    ticket_kwargs["agent_id"] = cell_id
    resp2 = api_call("board_add_task", port=args.port, **ticket_kwargs)
    check_ok(resp2)

    print(f"Agent \"{agent_name}\" created (id: {cell_id})")
    print(f"Ticket created in In Progress")

    # For non-action dispatch, send task text manually
    if not args.action and not args.no_task:
        booted = wait_for_boot(cell_id, args.port)
        if not booted:
            die("Agent failed to boot within 15 seconds")
        time.sleep(1.5)
        task_text = args.description
        if not task_text.endswith("\r") and not task_text.endswith("\n"):
            task_text += "\r"
        resp = api_call("send_text", port=args.port, id=cell_id, text=task_text)
        check_ok(resp)
        print(f"Task sent to \"{agent_name}\"")

    if args.wait:
        # For action dispatch, task is sent server-side after boot delay
        if args.action:
            time.sleep(3)
        rc = wait_for_idle(cell_id, agent_name, args.port)
        sys.exit(rc)


def cmd_task_show(args):
    """Display full details of a task."""
    st = get_state_local(args.port)
    t = resolve_task(st, args.identifier)

    if args.json:
        import json as _j
        print(_j.dumps(t, indent=2))
        return

    print()
    print(f"  {_bold(t.get('task', ''))}")
    print(f"  {_dim(t.get('slug', '') or t['id'])}")
    print()
    print(f"  {'Lane:':<14} {t.get('lane', '')}")
    print(f"  {'Group:':<14} {t.get('group', '')}")

    if t.get("agent_id"):
        agent = st.get("agents", {}).get(t["agent_id"])
        if agent:
            agent_slug = agent.get("slug", "") or t["agent_id"][:6]
            agent_str = f"{agent['name']} ({agent_slug})"
        else:
            agent_str = t["agent_id"][:6]
        print(f"  {'Agent:':<14} {agent_str}")
    if t.get("labels"):
        def _fmt_label(lb):
            return f"[{lb}]" if lb.startswith("torque:") else lb
        print(f"  {'Labels:':<14} {', '.join(_fmt_label(l) for l in t['labels'])}")

    if t.get("description"):
        print()
        print(f"  {_bold('Description:')}")
        for line in t["description"].splitlines():
            print(f"    {line}")

    if t.get("depends_on"):
        tasks = st.get("board_tasks", {})
        dep_strs = []
        deps = t["depends_on"]
        if isinstance(deps, str):
            try:
                deps = json.loads(deps)
            except (json.JSONDecodeError, TypeError):
                deps = [deps]
        for dep_id in deps:
            dep_t = tasks.get(dep_id)
            if dep_t:
                dep_lane = dep_t.get("lane", "?")
                mark = "\u2713" if _task_counts_as_done(dep_t) else "\u2717"
                dep_slug = dep_t.get("slug") or dep_id[:6]
                dep_strs.append(f"{mark} {dep_slug} ({dep_lane})")
            else:
                dep_strs.append(f"? {dep_id[:6]} (deleted)")
        print(f"  {'Depends on:':<14} {', '.join(dep_strs)}")
    if t.get("scheduled_at"):
        print(f"  {'Scheduled:':<14} {t['scheduled_at']}")
    if t.get("action_name"):
        print(f"  {'Action:':<14} {t['action_name']}")
    if t.get("action_vars"):
        tvars = t["action_vars"]
        if isinstance(tvars, dict) and tvars:
            print(f"  {'Variables:':<14}")
            for k, v in tvars.items():
                print(f"    {k}: {v}")
    if t.get("attachments"):
        print(f"  {'Attachments:':<14}")
        attachments = t["attachments"]
        if isinstance(attachments, str):
            try:
                attachments = json.loads(attachments)
            except (json.JSONDecodeError, TypeError):
                attachments = [attachments]
        for att in attachments:
            if isinstance(att, str):
                path = att
                name = Path(att).name
            else:
                path = att.get("path", "")
                name = att.get("filename", "")
            print(f"    {name or path}")
            if path and path != name:
                print(f"      path: {path}")
    if t.get("artifacts"):
        print(f"  {'Artifacts:':<14}")
        artifacts = t["artifacts"]
        if isinstance(artifacts, str):
            try:
                artifacts = json.loads(artifacts)
            except (json.JSONDecodeError, TypeError):
                artifacts = []
        for art in artifacts:
            if not isinstance(art, dict):
                print(f"    {art}")
                continue
            atype = art.get("type", "artifact")
            title = art.get("title") or art.get("filename") or atype
            print(f"    [{atype}] {title}")
            if art.get("path"):
                print(f"      ref: {art['path']}")
            if art.get("summary"):
                print(f"      summary: {art['summary']}")
    if t.get("verification_state") or t.get("verification_mode") \
            or t.get("verification_notes") \
            or t.get("verification_summary"):
        print()
        print(f"  {_bold('Verification:')}")
        if t.get("verification_state"):
            print(f"  {'State:':<14} {t['verification_state']}")
        if t.get("verification_mode"):
            print(f"  {'Mode:':<14} {t['verification_mode']}")
        summary = t.get("verification_summary") or {}
        if summary.get("tests_run"):
            print(f"  {'Tests run:':<14} {summary['tests_run']}")
        if "manual_smoke_done" in summary:
            print(f"  {'Manual smoke:':<14} {'yes' if summary['manual_smoke_done'] else 'no'}")
        if "deploy_needed" in summary:
            print(f"  {'Deploy needed:':<14} {'yes' if summary['deploy_needed'] else 'no'}")
        if "deploy_attempted" in summary:
            print(f"  {'Deploy tried:':<14} {'yes' if summary['deploy_attempted'] else 'no'}")
        if summary.get("human_validation_pending"):
            print(f"  {'Needs human:':<14} {summary['human_validation_pending']}")
        if t.get("verification_notes"):
            print(f"  {'Notes:':<14} {t['verification_notes']}")
        if t.get("verification_updated_by"):
            print(f"  {'Updated by:':<14} {t['verification_updated_by']}")
        if t.get("verification_updated_at"):
            print(f"  {'Updated at:':<14} {t['verification_updated_at']}")

    # Backward compat: show legacy fields if present on old tasks
    for field, label in [("instructions", "Instructions"),
                         ("context", "Context"),
                         ("criteria", "Criteria")]:
        val = t.get(field, "")
        if val:
            print()
            print(f"  {_bold(label + ':')}")
            for line in val.splitlines():
                print(f"    {line}")

    if t.get("external_id") or t.get("external_url"):
        print()
        if t.get("external_id"):
            print(f"  {'External ID:':<14} {t['external_id']}")
        if t.get("external_url"):
            print(f"  {'URL:':<14} {t['external_url']}")

    # Activity log
    msgs = t.get("messages") or []
    if msgs:
        print()
        print(f"  {_bold('Activity:')}")
        for m in msgs:
            ts = m.get("timestamp", 0)
            hhmm = time.strftime("%H:%M", time.localtime(ts)) if ts else "??:??"
            agent = m.get("agent_name", "?")
            act = m.get("action", "")
            txt = m.get("message", "")
            print(f"    [{hhmm}] {agent}: {txt}  {_dim('(' + act + ')')}")

    thread = t.get("messages_thread") or []
    if thread:
        print()
        print(f"  {_bold('Inline messages:')}")
        for m in thread:
            ts = m.get("timestamp", 0)
            hhmm = time.strftime("%H:%M", time.localtime(ts)) if ts else "??:??"
            sender = m.get("sender_agent_id", "?")
            recipient = m.get("recipient_agent_id", "?")
            txt = m.get("content", "")
            flag = "reply required" if m.get("reply_required") else "no reply required"
            print(f"    [{hhmm}] {sender} → {recipient}: {txt}  {_dim('(' + flag + ')')}")

    print()
    if t.get("created_at"):
        print(f"  {_dim('Created: ' + t['created_at'])}")
    if t.get("updated_at"):
        print(f"  {_dim('Updated: ' + t['updated_at'])}")
    print()


def cmd_task_list(args):
    """List tasks with optional filters."""
    st = get_state_local(args.port)
    lanes = st.get("board_lanes", [])
    tasks = st.get("board_tasks", {})

    if args.json:
        import json as _j
        # Apply filters before JSON output
        filtered = _filter_tasks(tasks, args)
        print(_j.dumps({"lanes": lanes, "tasks": filtered}, indent=2))
        return

    lane_filter = args.lane if hasattr(args, "lane") and args.lane else None
    found_any = False

    for lane in lanes:
        if lane == ARCHIVED_LANE and not getattr(args, "archived", False) \
                and not (lane_filter and lane.lower() == lane_filter.lower()):
            continue
        if lane_filter and lane.lower() != lane_filter.lower():
            continue
        lane_tasks = sorted(
            [t for t in _filter_tasks(tasks, args).values()
             if t["lane"] == lane],
            key=lambda t: t.get("position", 0),
            reverse=True,
        )
        if not lane_tasks and lane_filter:
            print(f"\n  {_bold(lane)} (0)")
            print(f"    {_dim('(empty)')}")
            found_any = True
            continue
        if not lane_tasks:
            continue
        found_any = True
        print(f"\n  {_bold(lane)} ({len(lane_tasks)})")
        for t in lane_tasks:
            tslug = _dim(t.get("slug", "") or t["id"][:6])
            parts = [f"    {tslug}  {t.get('task', '')}"]
            if t.get("agent_id"):
                a = st.get("agents", {}).get(t["agent_id"])
                if a:
                    parts.append(_cyan("→ " + a["name"]))
            if t.get("labels"):
                user_lbl = [l for l in t["labels"] if not l.startswith("torque:")]
                sys_lbl = [l for l in t["labels"] if l.startswith("torque:")]
                lbl_parts = []
                if user_lbl:
                    lbl_parts.append(", ".join(user_lbl))
                if sys_lbl:
                    lbl_parts.append(", ".join(f"[{l}]" for l in sys_lbl))
                parts.append(_dim("  ".join(lbl_parts)))
            print("  ".join(parts))

    if not found_any:
        print("\n  No tasks match the given filters.")
    print()


def _filter_tasks(tasks, args):
    """Apply CLI filters to a tasks dict, return filtered dict."""
    result = {}
    include_archived = getattr(args, "archived", False)
    lane_filter = getattr(args, "lane", None)
    for tid, t in tasks.items():
        if _task_is_archived(t) and not include_archived:
            if not lane_filter or t.get("lane", "").lower() != lane_filter.lower():
                continue
        if hasattr(args, "lane") and args.lane:
            if t.get("lane", "").lower() != args.lane.lower():
                continue
        if hasattr(args, "group") and args.group:
            if t.get("group", "").lower() != args.group.lower():
                continue
        if hasattr(args, "label") and args.label:
            task_labels = [l.lower() for l in t.get("labels", [])]
            if args.label.lower() not in task_labels:
                continue
        result[tid] = t
    return result


_TASK_EDIT_FIELDS = [
    "task", "lane", "group", "labels",
    "action_name", "action_vars",
    "artifacts",
    "verification_mode", "verification_state",
    "verification_notes", "verification_summary",
]

_TASK_EDIT_COMMENT = """\
# Edit task {id}
# Save and close the editor to apply changes.
# To abort, clear the 'task' field or leave the file unchanged.
# Lines starting with '#' are comments (only at the top level).
"""


def _task_to_yaml(t):
    """Serialize editable task fields to a YAML string with header comment."""
    yaml = _yaml()
    doc = {}
    for key in _TASK_EDIT_FIELDS:
        val = t.get(key, "")
        if key == "labels":
            doc[key] = val if isinstance(val, list) else []
        elif key == "action_vars":
            doc[key] = val if isinstance(val, dict) else {}
        elif key == "artifacts":
            doc[key] = val if isinstance(val, list) else []
        else:
            doc[key] = val or ""
    comment = _TASK_EDIT_COMMENT.format(id=t["id"])
    body = yaml.dump(doc, default_flow_style=False, sort_keys=False,
                     allow_unicode=True)
    return comment + "\n" + body


def _yaml_to_fields(text, original):
    """Parse edited YAML, return dict of changed fields (or None to abort)."""
    yaml = _yaml()
    # Strip comment lines before parsing
    lines = [l for l in text.splitlines() if not l.startswith("#")]
    cleaned = "\n".join(lines)
    try:
        doc = yaml.safe_load(cleaned)
    except yaml.YAMLError as exc:
        die(f"Invalid YAML:\n  {exc}")
    if not doc or not isinstance(doc, dict):
        return None
    if not doc.get("task", "").strip():
        return None  # abort

    fields = {}
    for key in _TASK_EDIT_FIELDS:
        if key not in doc:
            continue
        new_val = doc[key]
        if key == "labels":
            old_val = original.get(key, [])
        elif key == "action_vars":
            old_val = original.get(key, {})
        elif key == "artifacts":
            old_val = original.get(key, [])
        else:
            old_val = original.get(key, "")
        if key == "labels":
            new_val = new_val if isinstance(new_val, list) else []
            if new_val != old_val:
                fields[key] = new_val
        elif key == "action_vars":
            new_val = new_val if isinstance(new_val, dict) else {}
            if new_val != (old_val or {}):
                fields[key] = new_val
        elif key == "artifacts":
            new_val = new_val if isinstance(new_val, list) else []
            if new_val != (old_val or []):
                fields[key] = new_val
        else:
            new_val = str(new_val) if new_val is not None else ""
            old_val = str(old_val) if old_val else ""
            if new_val != old_val:
                fields[key] = new_val
    return fields


def _open_in_editor(initial_text, suffix=".yml"):
    """Write text to a temp file, open $EDITOR, return edited text."""
    editor = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "vi"
    with tempfile.NamedTemporaryFile(
        mode="w", suffix=suffix, prefix="torque-task-", delete=False
    ) as f:
        f.write(initial_text)
        tmp_path = f.name
    try:
        rc = subprocess.call([editor, tmp_path])
        if rc != 0:
            die(f"Editor exited with code {rc}")
        with open(tmp_path) as f:
            return f.read()
    finally:
        os.unlink(tmp_path)


def cmd_task_edit(args):
    """Edit task fields — opens $EDITOR with YAML, or use flags."""
    st = get_state_local(args.port)
    t = resolve_task(st, args.identifier)

    # Check if any inline flags were provided
    has_flags = any(
        getattr(args, attr, None) is not None
        for attr in (
            "task", "action", "labels", "group", "engineer", "at", "depends_on",
            "verify_mode", "verify_state", "verify_note", "verify_tests",
            "verify_human",
        )
    ) or getattr(args, "var", None)
    has_flags = has_flags or args.verify_smoke_done \
        or args.verify_deploy_needed or args.verify_deploy_attempted

    if has_flags:
        # Inline flag mode (non-interactive)
        fields = {}
        if args.task is not None:
            fields["task"] = args.task
        if getattr(args, "action", None) is not None:
            fields["action_name"] = args.action
        if getattr(args, "var", None):
            tvars = {}
            for kv in args.var:
                k, _, v = kv.partition("=")
                if k:
                    tvars[k] = v
            fields["action_vars"] = tvars
        if args.labels is not None:
            fields["labels"] = [l.strip() for l in args.labels.split(",")
                                if l.strip()]
        if args.group is not None:
            fields["group"] = args.group
        if args.engineer is not None:
            target_group = str(args.group or t.get("group", "") or "").strip()
            fields["assigned_engineer_id"] = _validate_engineer_assignment(
                st, args.engineer, target_group
            )
        if getattr(args, "at", None) is not None:
            fields["scheduled_at"] = _parse_relative_time(args.at)
        if getattr(args, "depends_on", None) is not None:
            dep_ids = _resolve_dep_ids(st, args.depends_on)
            fields["depends_on"] = dep_ids
        if args.verify_mode is not None:
            fields["verification_mode"] = args.verify_mode
        if args.verify_state is not None:
            fields["verification_state"] = args.verify_state
        if args.verify_note is not None:
            fields["verification_notes"] = args.verify_note
        summary = dict(t.get("verification_summary", {}) or {})
        if args.verify_tests is not None:
            if args.verify_tests:
                summary["tests_run"] = args.verify_tests
            else:
                summary.pop("tests_run", None)
        if args.verify_smoke_done:
            summary["manual_smoke_done"] = True
        if args.verify_deploy_needed:
            summary["deploy_needed"] = True
        if args.verify_deploy_attempted:
            summary["deploy_attempted"] = True
        if args.verify_human is not None:
            if args.verify_human:
                summary["human_validation_pending"] = args.verify_human
            else:
                summary.pop("human_validation_pending", None)
        if any(
            value is not None for value in (
                args.verify_tests, args.verify_human,
                args.verify_mode, args.verify_state, args.verify_note,
            )
        ) or args.verify_smoke_done or args.verify_deploy_needed \
                or args.verify_deploy_attempted:
            fields["verification_summary"] = summary
    else:
        # Interactive editor mode
        original_text = _task_to_yaml(t)
        edited_text = _open_in_editor(original_text)
        if edited_text == original_text:
            print("No changes.")
            return
        fields = _yaml_to_fields(edited_text, t)
        if fields is None:
            print("Aborted.")
            return

    if not fields:
        print("No changes.")
        return

    _validate_task_group_assignment_change(st, t, fields)

    resp = api_call("board_update_task", port=args.port, id=t["id"], **fields)
    check_ok(resp)
    print(f"Updated task {t.get('slug', '') or t['id'][:6]}")


def cmd_engineer_list(args):
    """List engineers with ownership counts."""
    st = get_state_local(args.port)
    engineers = _engineers_with_counts(st)

    if args.json:
        print(json.dumps({"engineers": engineers}, indent=2))
        return

    if not engineers:
        print("\n  No engineers.\n")
        return

    print(f"\n  {_bold('Engineers')} ({len(engineers)})")
    for engineer in engineers:
        eslug = _dim(engineer.get("slug", "") or engineer["id"][:6])
        dismissed_at = int(engineer.get("dismissed_at", 0) or 0)
        status = "dismissed" if dismissed_at else (
            engineer.get("status", "") or "stopped"
        )
        print(
            "    "
            f"{eslug}  {engineer.get('name', '')}  "
            f"{_dim(status)}  "
            f"workers={engineer.get('worker_count', 0)}  "
            f"tasks={engineer.get('task_count', 0)}"
        )
    print()


def cmd_engineer_dismiss(args):
    """Dismiss/pause an engineer while preserving history."""
    state_data = get_state(args.port)
    engineer = _resolve_engineer_cell(state_data, args.identifier)
    resp = api_call(
        "engineer_dismiss",
        port=args.port,
        engineer_id=engineer["id"],
        reason=args.reason or "",
    )
    data = check_ok(resp)
    if data.get("already_dismissed"):
        print(f"Engineer \"{engineer['name']}\" is already dismissed")
    else:
        print(
            f"Dismissed \"{engineer['name']}\" "
            f"(closed {data.get('closed_sessions', 0)} sessions)"
        )


def cmd_engineer_rehire(args):
    """Rehire/resume a dismissed engineer."""
    state_data = get_state(args.port)
    engineer = _resolve_engineer_cell(state_data, args.identifier)
    resp = api_call(
        "engineer_rehire",
        port=args.port,
        engineer_id=engineer["id"],
    )
    data = check_ok(resp)
    if data.get("already_hired"):
        print(f"Engineer \"{engineer['name']}\" is already active")
    else:
        replayed = data.get("replayed_messages", 0)
        suffix = f"; replayed {replayed} buffered messages" if replayed else ""
        print(f"Rehired \"{engineer['name']}\"{suffix}")


def _parse_key_value_settings(items):
    updates = {}
    for kv in items or []:
        if "=" not in kv:
            die(f"Invalid setting format: {kv} (expected key=value)")
        key, value = kv.split("=", 1)
        try:
            value = json.loads(value)
        except (json.JSONDecodeError, ValueError):
            pass
        updates[key] = value
    return updates


def cmd_architect_settings(args):
    """Show per-group Architect settings."""
    state_data = get_state(args.port)
    group = resolve_group(state_data, args.group)
    if getattr(args, "set", None):
        die("Updating architect settings from the CLI has been removed.")

    resp = api_call("get_architect_settings", port=args.port, group=group)
    data = check_ok(resp)
    settings = data.get("settings", {})
    if args.json:
        print(json.dumps(settings, indent=2))
        return
    print(f"Architect settings for \"{group}\":")
    for key, value in sorted(settings.items()):
        if value or value == 0 or value is False:
            print(f"  {key}: {value}")


