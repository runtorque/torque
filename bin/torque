#!/usr/bin/env python3
"""Torque CLI — control the Torque daemon from the terminal.

Talks to the Torque daemon over HTTP (POST /api/cmd).
"""

import argparse
import json
import os
from pathlib import Path
import re
import socket
import signal
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

PROJECT_ROOT = Path(__file__).resolve().parents[1]
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

from torque.doctor import (
    build_doctor_report_for_db,
    format_doctor_report,
    format_mcp_health_report,
)
from torque.mcp_retry import (
    DEFAULT_ATTEMPTS,
    DEFAULT_BACKOFFS,
    ensure_api_payload_idempotency,
    is_api_write_command,
    is_transient_exception,
    is_transient_http_status,
)

DEFAULT_PORT = 18932
DESKTOP_DEFAULT_PORT = 18933
DESKTOP_DEFAULT_PROFILE = "desktop"

_yaml_mod = None

def _yaml():
    """Lazy-load PyYAML, with a helpful install hint on failure."""
    global _yaml_mod
    if _yaml_mod is None:
        try:
            import yaml
            _yaml_mod = yaml
        except ImportError:
            die("PyYAML is required for this command.\n"
                "  Install with: pip3 install pyyaml")
    return _yaml_mod
ITERM2_RUNTIME_DIR = Path(os.path.expanduser(
    "~/Library/Application Support/iTerm2/Scripts/torque/torque"))


def _truthy_env(name):
    return os.environ.get(name, "").lower() in ("1", "true", "yes")


def _slugify_profile(name):
    text = re.sub(r"[^A-Za-z0-9._-]+", "-", (name or "").strip().lower())
    text = text.strip(".-_")
    return text or "default"


def _resolve_runtime_dir():
    explicit = os.environ.get("TORQUE_DATA_DIR", "").strip()
    if explicit:
        return Path(os.path.expanduser(explicit))

    profile = os.environ.get("TORQUE_PROFILE", "").strip()
    if not profile and _truthy_env("TORQUE_STANDALONE"):
        profile = "standalone"
    if profile:
        return Path.home() / ".torque" / "profiles" / _slugify_profile(profile)
    return ITERM2_RUNTIME_DIR


def _argv_has_flag(flag):
    return any(arg == flag or arg.startswith(flag + "=") for arg in sys.argv[1:])


def _resolve_desktop_port(args):
    desktop_port = getattr(args, "desktop_port", None)
    if desktop_port is not None:
        return int(desktop_port)

    if _argv_has_flag("--port") and getattr(args, "port", None) is not None:
        return int(args.port)
    env_port = (os.environ.get("TORQUE_DESKTOP_PORT", "") or "").strip()
    return int(env_port or DESKTOP_DEFAULT_PORT)


def _resolve_desktop_profile(explicit=""):
    profile = (explicit or "").strip() or os.environ.get("TORQUE_DESKTOP_PROFILE", "").strip()
    return profile or DESKTOP_DEFAULT_PROFILE


def _resolve_desktop_data_dir(profile, explicit=""):
    path = (explicit or "").strip() or os.environ.get("TORQUE_DESKTOP_DATA_DIR", "").strip()
    if path:
        return Path(os.path.expanduser(path))
    return Path.home() / ".torque" / "profiles" / _slugify_profile(profile)


def _resolve_desktop_entrypoint():
    return Path(__file__).resolve().parents[1] / "torque_desktop.py"


def _candidate_iterm2_pythons():
    project_candidates = {
        path.resolve()
        for path in Path.home().glob(
            "Library/Application Support/iTerm2/Scripts/torque/iterm2env/versions/*/bin/python3"
        )
    }
    fallback_candidates = {
        path.resolve()
        for pattern in (
            "Library/Application Support/iTerm2/iterm2env-*/versions/*/bin/python3",
            ".config/iterm2/AppSupport/iterm2env-*/versions/*/bin/python3",
        )
        for path in Path.home().glob(pattern)
    }

    candidates = project_candidates or fallback_candidates
    if candidates:
        def _sort_key(path):
            version = path.parents[1].name
            parts = []
            for part in version.split("."):
                try:
                    parts.append(int(part))
                except ValueError:
                    parts.append(part)
            return tuple(parts)

        return sorted(candidates, key=_sort_key)
    return []


def _resolve_desktop_python(explicit=""):
    path = (explicit or "").strip() or os.environ.get("TORQUE_DESKTOP_PYTHON", "").strip()
    if path:
        return Path(os.path.expanduser(path))

    candidates = _candidate_iterm2_pythons()
    if candidates:
        return candidates[-1]

    return Path(sys.executable).resolve()


def _python_has_module(python_path, module_name):
    try:
        result = subprocess.run(
            [str(python_path), "-c", f"import {module_name}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        return False
    return result.returncode == 0


def _ensure_desktop_runtime_ready(python_path):
    python_path = Path(python_path)
    if not python_path.exists():
        die(f"Desktop Python not found: {python_path}")
    if not _python_has_module(python_path, "webview"):
        die(
            "pywebview is not installed in the Python runtime that will launch "
            f"Torque desktop: {python_path}\n"
            "  If you want the iTerm2-managed runtime, run: make desktop-deps\n"
            "  Otherwise install pywebview into the interpreter passed via "
            "--python or TORQUE_DESKTOP_PYTHON."
        )


RUNTIME_DIR = _resolve_runtime_dir()
TORQUE_LOG = str(RUNTIME_DIR / "torque.log")
TORQUE_DB = str(RUNTIME_DIR / "torque.db")
ARCHIVED_LANE = "Archived"


def _task_is_archived(task):
    return (task or {}).get("lane") == ARCHIVED_LANE


def _task_counts_as_done(task):
    lane = (task or {}).get("lane", "")
    if lane == "Done":
        return True
    return lane == ARCHIVED_LANE \
        and (task or {}).get("archived_from_lane", "") == "Done"


# ---------------------------------------------------------------------------
# SQLite direct reads (no daemon needed)
# ---------------------------------------------------------------------------

import sqlite3

def _db_available():
    """Check if the SQLite database file exists."""
    return os.path.isfile(TORQUE_DB)


def _db_read(query_fn):
    """Open the DB read-only, run query_fn(conn), return result."""
    conn = sqlite3.connect(f"file:{TORQUE_DB}?mode=ro", uri=True)
    try:
        return query_fn(conn)
    finally:
        conn.close()


def db_read_board_tasks():
    """Read board tasks directly from SQLite."""
    def _query(conn):
        c = conn.cursor()
        rows = c.execute("SELECT * FROM board_tasks").fetchall()
        if not rows:
            return {}
        cols = [d[0] for d in c.description]
        tasks = {}
        for row in rows:
            d = dict(zip(cols, row))
            d["group"] = d.pop("group_name", "")
            try:
                d["labels"] = json.loads(d.get("labels", "[]"))
            except (json.JSONDecodeError, TypeError):
                d["labels"] = []
            try:
                d["messages"] = json.loads(d.get("messages", "[]"))
            except (json.JSONDecodeError, TypeError):
                d["messages"] = []
            try:
                d["messages_thread"] = json.loads(
                    d.get("messages_thread", "[]"))
            except (json.JSONDecodeError, TypeError):
                d["messages_thread"] = []
            try:
                d["action_vars"] = json.loads(d.get("action_vars", "{}"))
            except (json.JSONDecodeError, TypeError):
                d["action_vars"] = {}
            try:
                d["verification_summary"] = json.loads(
                    d.get("verification_summary", "{}"))
            except (json.JSONDecodeError, TypeError):
                d["verification_summary"] = {}
            try:
                d["worktree_boundary"] = json.loads(
                    d.get("worktree_boundary", "{}"))
            except (json.JSONDecodeError, TypeError):
                d["worktree_boundary"] = {}
            tasks[d["id"]] = d
        return tasks
    return _db_read(_query)


def db_read_board_lanes():
    """Read board lanes directly from SQLite."""
    def _query(conn):
        return [row[0] for row in conn.execute(
            "SELECT name FROM board_lanes ORDER BY position")]
    return _db_read(_query)


def db_read_agents():
    """Read agents directly from SQLite (persisted fields only)."""
    def _query(conn):
        c = conn.cursor()
        rows = c.execute("SELECT * FROM agents").fetchall()
        if not rows:
            return {}
        cols = [d[0] for d in c.description]
        agents = {}
        for row in rows:
            d = dict(zip(cols, row))
            d["group"] = d.pop("group_name", "")
            agents[d["id"]] = d
        return agents
    return _db_read(_query)


def db_read_state():
    """Read full state from SQLite (for read-only commands).
    Returns a dict matching the shape of get_state() output,
    minus ephemeral fields."""
    def _query(conn):
        c = conn.cursor()

        # Agents
        agents = {}
        rows = c.execute("SELECT * FROM agents").fetchall()
        if rows:
            cols = [d[0] for d in c.description]
            for row in rows:
                d = dict(zip(cols, row))
                d["group"] = d.pop("group_name", "")
                agents[d["id"]] = d

        # Groups
        groups = {}
        group_slugs = {}
        rows = c.execute("SELECT * FROM groups ORDER BY position").fetchall()
        if rows:
            cols = [d[0] for d in c.description]
            for row in rows:
                d = dict(zip(cols, row))
                groups[d["name"]] = []
                if d.get("slug"):
                    group_slugs[d["name"]] = d["slug"]
        for row in c.execute(
                "SELECT group_name, agent_id FROM group_members "
                "ORDER BY group_name, position"):
            gname, aid = row
            if gname in groups:
                groups[gname].append(aid)

        # Board lanes
        lanes = [row[0] for row in c.execute(
            "SELECT name FROM board_lanes ORDER BY position")]

        # Board tasks
        tasks = {}
        rows = c.execute("SELECT * FROM board_tasks").fetchall()
        if rows:
            cols = [d[0] for d in c.description]
            for row in rows:
                d = dict(zip(cols, row))
                d["group"] = d.pop("group_name", "")
                try:
                    d["labels"] = json.loads(d.get("labels", "[]"))
                except (json.JSONDecodeError, TypeError):
                    d["labels"] = []
                try:
                    d["messages"] = json.loads(d.get("messages", "[]"))
                except (json.JSONDecodeError, TypeError):
                    d["messages"] = []
                try:
                    d["messages_thread"] = json.loads(
                        d.get("messages_thread", "[]"))
                except (json.JSONDecodeError, TypeError):
                    d["messages_thread"] = []
                try:
                    d["depends_on"] = json.loads(d.get("depends_on", "[]"))
                except (json.JSONDecodeError, TypeError):
                    d["depends_on"] = []
                try:
                    d["attachments"] = json.loads(d.get("attachments", "[]"))
                except (json.JSONDecodeError, TypeError):
                    d["attachments"] = []
                try:
                    d["artifacts"] = json.loads(d.get("artifacts", "[]"))
                except (json.JSONDecodeError, TypeError):
                    d["artifacts"] = []
                try:
                    d["action_vars"] = json.loads(d.get("action_vars", "{}"))
                except (json.JSONDecodeError, TypeError):
                    d["action_vars"] = {}
                try:
                    d["verification_summary"] = json.loads(
                        d.get("verification_summary", "{}"))
                except (json.JSONDecodeError, TypeError):
                    d["verification_summary"] = {}
                try:
                    d["worktree_boundary"] = json.loads(
                        d.get("worktree_boundary", "{}"))
                except (json.JSONDecodeError, TypeError):
                    d["worktree_boundary"] = {}
                tasks[d["id"]] = d

        # Schedules
        schedules = {}
        try:
            rows = c.execute("SELECT * FROM schedules").fetchall()
            if rows:
                cols = [d[0] for d in c.description]
                for row in rows:
                    d = dict(zip(cols, row))
                    d["group"] = d.pop("group_name", "")
                    d["enabled"] = bool(d.get("enabled", 1))
                    try:
                        d["labels"] = json.loads(d.get("labels", "[]"))
                    except (json.JSONDecodeError, TypeError):
                        d["labels"] = []
                    try:
                        d["action_vars"] = json.loads(
                            d.get("action_vars", "{}"))
                    except (json.JSONDecodeError, TypeError):
                        d["action_vars"] = {}
                    schedules[d["id"]] = d
        except Exception:
            pass  # table may not exist yet

        task_id_aliases = {}
        try:
            rows = c.execute(
                "SELECT legacy_id, task_id FROM task_id_aliases"
            ).fetchall()
            task_id_aliases = {
                legacy_id: task_id for legacy_id, task_id in rows
                if legacy_id and task_id
            }
        except Exception:
            task_id_aliases = {}

        return {
            "agents": agents,
            "groups": groups,
            "group_slugs": group_slugs,
            "board_lanes": lanes,
            "board_tasks": tasks,
            "schedules": schedules,
            "task_id_aliases": task_id_aliases,
        }
    return _db_read(_query)


def db_read_doctor_report():
    """Read the doctor report directly from SQLite."""
    return build_doctor_report_for_db(TORQUE_DB)


def _is_tombstoned_cell(cell):
    try:
        return float((cell or {}).get("deleted_at", 0) or 0) > 0
    except (TypeError, ValueError):
        return False


def _iter_engineers_from_state(state_data):
    """Yield engineer agent dicts in the state's natural order."""
    for cell in (state_data.get("agents", {}) or {}).values():
        if _is_tombstoned_cell(cell):
            continue
        if cell.get("cell_type", "") != "agent":
            continue
        if str(cell.get("kind", "") or "").strip() != "engineer":
            continue
        yield cell


def _engineer_counts_from_state(state_data):
    """Return worker/task counts keyed by engineer id."""
    worker_counts = {}
    task_counts = {}
    for cell in (state_data.get("agents", {}) or {}).values():
        if _is_tombstoned_cell(cell):
            continue
        if cell.get("cell_type", "") != "agent":
            continue
        if str(cell.get("kind", "") or "").strip() != "worker":
            continue
        owner_id = str(cell.get("owner_engineer_id", "") or "").strip()
        if not owner_id:
            continue
        worker_counts[owner_id] = worker_counts.get(owner_id, 0) + 1
    for task in (state_data.get("board_tasks", {}) or {}).values():
        engineer_id = str(task.get("assigned_engineer_id", "") or "").strip()
        if not engineer_id:
            continue
        task_counts[engineer_id] = task_counts.get(engineer_id, 0) + 1
    return worker_counts, task_counts


def _engineers_with_counts(state_data):
    """Return engineers annotated with worker/task counts."""
    worker_counts, task_counts = _engineer_counts_from_state(state_data)
    engineers = []
    for engineer in _iter_engineers_from_state(state_data):
        engineers.append(
            {
                "id": engineer["id"],
                "name": engineer.get("name", ""),
                "slug": engineer.get("slug", ""),
                "status": engineer.get("status", "") or "stopped",
                "dismissed_at": int(engineer.get("dismissed_at", 0) or 0),
                "worker_count": int(worker_counts.get(engineer["id"], 0) or 0),
                "task_count": int(task_counts.get(engineer["id"], 0) or 0),
            }
        )
    return engineers


def _resolve_engineer_by_slug(state_data, engineer_slug: str):
    """Resolve an engineer slug to its cell dict, or return None."""
    wanted = str(engineer_slug or "").strip().lower()
    if not wanted:
        return None
    for engineer in _iter_engineers_from_state(state_data):
        if str(engineer.get("slug", "") or "").strip().lower() == wanted:
            return engineer
    return None


def _resolve_engineer_id_by_slug(state_data, engineer_slug: str) -> str:
    """Resolve an engineer slug to its agent id, or return an empty string."""
    engineer = _resolve_engineer_by_slug(state_data, engineer_slug)
    return str(engineer.get("id", "") or "") if engineer else ""


def _resolve_engineer_cell(state_data, identifier: str):
    """Resolve an engineer by id/slug/name/prefix or exit with a clear error."""
    cell = resolve_cell(state_data, identifier)
    if str(cell.get("kind", "") or "").strip() != "engineer":
        die(f"'{identifier}' is not an engineer")
    return cell


def _resolve_architect_cell(state_data, identifier: str):
    """Resolve an architect by id/slug/name/prefix or exit with a clear error."""
    cell = resolve_cell(state_data, identifier)
    if str(cell.get("kind", "") or "").strip() != "architect":
        die(f"'{identifier}' is not an architect")
    return cell


def _validate_engineer_assignment(state_data, engineer_slug: str, group: str) -> str:
    """Resolve an engineer slug for a specific group or exit with a clear error."""
    wanted = str(engineer_slug or "").strip()
    if not wanted:
        return ""
    engineer = _resolve_engineer_by_slug(state_data, wanted)
    if not engineer:
        die(f"no engineer with slug '{wanted}'")
    if _is_tombstoned_cell(engineer):
        die(f"engineer '{wanted}' is tombstoned")
    engineer_group = str(engineer.get("group", "") or "").strip()
    if engineer_group != str(group or "").strip():
        die(
            f"engineer '{wanted}' belongs to group '{engineer_group}', "
            f"not '{group}'"
        )
    return str(engineer.get("id", "") or "")


def _validate_task_group_assignment_change(state_data, task, fields):
    """Reject group moves that would leave an assigned engineer out of scope."""
    if "group" not in fields:
        return
    target_group = str(fields.get("group", "") or task.get("group", "") or "").strip()
    assigned_engineer_id = str(
        fields.get(
            "assigned_engineer_id",
            task.get("assigned_engineer_id", ""),
        ) or ""
    ).strip()
    if not assigned_engineer_id:
        return
    engineer = (state_data.get("agents", {}) or {}).get(assigned_engineer_id)
    if not engineer or _is_tombstoned_cell(engineer):
        return
    engineer_group = str(engineer.get("group", "") or "").strip()
    if engineer_group == target_group:
        return
    engineer_label = (
        str(engineer.get("slug", "") or "").strip()
        or str(engineer.get("name", "") or "").strip()
        or assigned_engineer_id
    )
    die(
        f"cannot move assigned task to group '{target_group}' while "
        f"engineer '{engineer_label}' belongs to group '{engineer_group}'; "
        "clear or reassign --engineer"
    )


def get_state_local(port):
    """Try SQLite first, fall back to HTTP daemon.
    Use for read-only commands that don't need ephemeral fields."""
    if _db_available():
        try:
            return db_read_state()
        except Exception:
            pass
    return get_state(port)


def get_doctor_local(port):
    """Prefer the live daemon doctor endpoint; fall back to SQLite offline."""
    try:
        with socket.create_connection(("127.0.0.1", int(port)), timeout=0.2):
            pass
    except OSError:
        if _db_available():
            try:
                return db_read_doctor_report()
            except Exception:
                pass
    else:
        resp = api_call("doctor", port=port)
        return check_ok(resp)
    resp = api_call("doctor", port=port)
    return check_ok(resp)


# ---------------------------------------------------------------------------
# HTTP helpers
# ---------------------------------------------------------------------------

def api_url(port):
    return f"http://127.0.0.1:{port}/api/cmd"


def _queue_failed_api_write(payload, *, attempts, last_error):
    key = str(payload.get("idempotency_key", "") or "").strip()
    if not key or not is_api_write_command(payload.get("cmd", "")):
        return False
    try:
        from torque.db import TorqueDB
        db = TorqueDB(Path(TORQUE_DB))
        db.init()
        try:
            db.enqueue_failed_write(
                idempotency_key=key,
                endpoint="/api/cmd",
                method="POST",
                surface="api",
                tool_name=str(payload.get("cmd", "") or ""),
                caller_id=str(payload.get("cell_id", "") or ""),
                payload=payload,
                attempts=attempts,
                last_error=last_error,
            )
            db.record_mcp_health_event(
                surface="api",
                tool_name=str(payload.get("cmd", "") or ""),
                event="drop",
                error=last_error,
            )
        finally:
            db.close()
        return True
    except Exception:
        return False


def api_call(cmd, port=DEFAULT_PORT, **kwargs):
    """Send a command to the Torque daemon, return parsed response."""
    payload, _key, _cmd_name = ensure_api_payload_idempotency({"cmd": cmd, **kwargs})
    last_error = ""
    for attempt in range(1, DEFAULT_ATTEMPTS + 1):
        data = json.dumps(payload).encode()
        req = urllib.request.Request(
            api_url(port),
            data=data,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                return json.loads(resp.read())
        except urllib.error.HTTPError as exc:
            body = exc.read().decode(errors="replace")
            if is_transient_http_status(exc.code) and attempt < DEFAULT_ATTEMPTS:
                last_error = f"HTTP {exc.code}: {body}"
                time.sleep(DEFAULT_BACKOFFS[min(attempt - 1, len(DEFAULT_BACKOFFS) - 1)])
                continue
            if is_transient_http_status(exc.code):
                last_error = f"HTTP {exc.code}: {body}"
                queued = _queue_failed_api_write(
                    payload,
                    attempts=attempt,
                    last_error=last_error,
                )
                if queued:
                    die(
                        "Torque daemon returned repeated transient errors; "
                        "write was queued durably for replay on next daemon boot.\n"
                        f"  ({last_error})"
                    )
            try:
                return json.loads(body)
            except Exception:
                die(f"HTTP {exc.code}: {body}")
        except urllib.error.URLError as exc:
            reason = exc.reason if isinstance(exc.reason, BaseException) else exc
            if is_transient_exception(reason) and attempt < DEFAULT_ATTEMPTS:
                last_error = str(exc.reason)
                time.sleep(DEFAULT_BACKOFFS[min(attempt - 1, len(DEFAULT_BACKOFFS) - 1)])
                continue
            last_error = str(exc.reason)
            queued = _queue_failed_api_write(
                payload,
                attempts=attempt,
                last_error=last_error,
            )
            if queued:
                die(
                    "Cannot connect to Torque daemon; write was queued durably "
                    "for replay on next daemon boot.\n"
                    f"  ({exc.reason})"
                )
            die(f"Cannot connect to Torque daemon on localhost:{port}\n"
                f"  Is it running? Start with: make run (Toolbelt: Scripts menu → torque)\n"
                f"  ({exc.reason})")


def die(msg):
    print(f"Error: {msg}", file=sys.stderr)
    sys.exit(1)


def check_ok(resp):
    """Check API response, die on error, return data."""
    if not resp:
        die("Empty response from daemon")
    if not resp.get("ok"):
        die(resp.get("error", "Unknown error"))
    return resp.get("data", {})


# ---------------------------------------------------------------------------
# Daemon lifecycle helpers
# ---------------------------------------------------------------------------

def _resolve_daemon_port(args):
    if getattr(args, "daemon_port", None) is not None:
        return int(args.daemon_port)
    if _argv_has_flag("--port") and getattr(args, "port", None) is not None:
        return int(args.port)
    env_port = (os.environ.get("TORQUE_PORT", "") or "").strip()
    return int(env_port or DESKTOP_DEFAULT_PORT)


def _resolve_daemon_status_port(args):
    return _resolve_daemon_port(args)


def _daemon_port_is_open(port):
    try:
        with socket.create_connection(("127.0.0.1", int(port)), timeout=0.5):
            pass
        return True
    except OSError:
        return False


def _usable_pid(value, *, require_running=True):
    text = str(value or "").strip()
    try:
        pid = int(text)
    except (TypeError, ValueError):
        return ""
    if pid <= 0:
        return ""
    if require_running:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return ""
        except PermissionError:
            pass
        except OSError:
            return ""
    return str(pid)


def _read_text(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return ""


def _lsof_pid(port):
    try:
        out = subprocess.run(
            ["lsof", "-ti", f"TCP:{int(port)}", "-sTCP:LISTEN"],
            capture_output=True, text=True, timeout=2,
        ).stdout
    except (OSError, subprocess.SubprocessError, ValueError):
        out = ""
    for line in out.splitlines():
        if pid := _usable_pid(line, require_running=False):
            return pid
    return ""


def _daemon_stop_pid_from_file(port):
    seen = set()
    directories = [_resolve_runtime_dir()]
    if int(port) == DESKTOP_DEFAULT_PORT:
        directories.append(_resolve_desktop_data_dir(_resolve_desktop_profile()))
    if int(port) == DEFAULT_PORT:
        directories.append(PROJECT_ROOT)
    for directory in directories:
        path = Path(directory).expanduser() / "torque.pid"
        if path in seen:
            continue
        seen.add(path)
        if pid := _usable_pid(_read_text(path)):
            return pid
    return ""


def _daemon_stop_target_pid(port):
    return _lsof_pid(port) or _daemon_stop_pid_from_file(port)


def _wait_for_daemon_stop(port, *, timeout):
    deadline = time.monotonic() + max(0.0, float(timeout))
    while True:
        if not _daemon_port_is_open(port):
            return True
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return not _daemon_port_is_open(port)
        time.sleep(min(0.1, remaining))


def _daemon_stop_error(message, code):
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(code)


def _force_stop_daemon(port, timeout):
    pid = _daemon_stop_target_pid(port)
    if not pid:
        print(f"No daemon process found on port {port}.")
        return

    try:
        os.kill(int(pid), signal.SIGTERM)
    except ProcessLookupError:
        pass
    except PermissionError as exc:
        _daemon_stop_error(
            f"Permission denied sending SIGTERM to PID {pid}: {exc}",
            3,
        )
    except (OSError, TypeError, ValueError) as exc:
        _daemon_stop_error(f"Could not send SIGTERM to PID {pid}: {exc}", 3)
    else:
        print(f"Sent SIGTERM to PID {pid}.")

    if _wait_for_daemon_stop(port, timeout=timeout):
        print(f"Torque daemon stopped (port {port} freed).")
        return
    _daemon_stop_error(
        f"Timed out waiting for Torque daemon to stop on port {port}.",
        1,
    )


def _daemon_pid(runtime, port):
    pid = _usable_pid(runtime.get("pid"), require_running=False)
    if pid:
        return pid
    data_dir = str(runtime.get("data_dir", "") or "").strip()
    if data_dir:
        pid_file = Path(os.path.expanduser(data_dir)) / "torque.pid"
        if pid := _usable_pid(_read_text(pid_file)):
            return pid
    return _lsof_pid(port) or "(unknown)"


def _read_version_file():
    return _read_text(PROJECT_ROOT / "VERSION")


def _format_uptime(started_at, now=None):
    if started_at in (None, ""):
        return ""
    try:
        started = float(started_at)
    except (TypeError, ValueError):
        try:
            from datetime import datetime
            started = datetime.fromisoformat(
                str(started_at).strip().replace("Z", "+00:00")
            ).timestamp()
        except (TypeError, ValueError):
            return ""
    elapsed = max(0, int((time.time() if now is None else now) - started))
    days, remainder = divmod(elapsed, 86400)
    hours, remainder = divmod(remainder, 3600)
    minutes, seconds = divmod(remainder, 60)
    parts = (
        ([f"{days}d"] if days else [])
        + ([f"{hours}h"] if hours else [])
        + ([f"{minutes}m"] if minutes else [])
    ) or [f"{seconds}s"]
    return " ".join(parts[:3])


def _daemon_log_path(runtime):
    for key in ("log_path", "log_file", "logs"):
        path = str(runtime.get(key, "") or "").strip()
        if path:
            return path

    data_dir = str(runtime.get("data_dir", "") or "").strip()
    if not data_dir:
        return ""
    return str(Path(os.path.expanduser(data_dir)) / "torque.log")


def _print_daemon_status_line(label, value):
    prefix = f"{label}:"
    if len(prefix) >= 8:
        print(f"{prefix} {value}")
    else:
        print(f"{prefix:<8}{value}")


# ---------------------------------------------------------------------------
# Name / ID resolution
# ---------------------------------------------------------------------------

def get_state(port):
    """Fetch current state from daemon."""
    resp = api_call("refresh", port=port)
    return check_ok(resp)


def resolve_cell(state_data, identifier):
    """Resolve a name, slug, or ID to a cell dict. Dies on ambiguity."""
    agents = state_data.get("agents", {})

    # Exact ID match
    if identifier in agents and not _is_tombstoned_cell(agents[identifier]):
        return agents[identifier]

    # Slug match (slugs are lowercase by construction)
    slug_matches = [c for c in agents.values()
                    if not _is_tombstoned_cell(c)
                    and c.get("slug") and c["slug"] == identifier.lower()]
    if len(slug_matches) == 1:
        return slug_matches[0]
    if len(slug_matches) > 1:
        print(f"Ambiguous slug \"{identifier}\" matches {len(slug_matches)} cells:",
              file=sys.stderr)
        for m in slug_matches:
            print(f"  {m['id']}  {m['name']}  ({m.get('group', '')})",
                  file=sys.stderr)
        die("Use the ID instead")

    # Name match (case-insensitive)
    matches = [c for c in agents.values()
               if not _is_tombstoned_cell(c)
               and c["name"].lower() == identifier.lower()]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        print(f"Ambiguous name \"{identifier}\" matches {len(matches)} cells:",
              file=sys.stderr)
        for m in matches:
            print(f"  {m['id']}  {m['name']}  ({m.get('group', '')})",
                  file=sys.stderr)
        die("Use the ID or slug instead")

    # Partial ID match (prefix)
    matches = [c for c in agents.values()
               if not _is_tombstoned_cell(c)
               and c["id"].startswith(identifier.lower())]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        print(f"Ambiguous prefix \"{identifier}\" matches {len(matches)} cells:",
              file=sys.stderr)
        for m in matches:
            print(f"  {m['id']}  {m['name']}", file=sys.stderr)
        die("Use the full ID")

    die(f"No agent or terminal matching \"{identifier}\"")


def resolve_group(state_data, identifier):
    """Resolve a group name, slug, or case-insensitive name. Dies if not found."""
    groups = state_data.get("groups", {})
    group_slugs = state_data.get("group_slugs", {})

    # Exact name match
    if identifier in groups:
        return identifier

    # Slug match (slugs are lowercase by construction)
    ident_lower = identifier.lower()
    for name, slug in group_slugs.items():
        if slug == ident_lower:
            return name

    # Case-insensitive name match
    for name in groups:
        if name.lower() == ident_lower:
            return name

    die(f"No group matching \"{identifier}\"")


def resolve_repo_root(identifier=""):
    """Resolve an explicit path/current directory to Torque's common repo root."""
    base = os.path.expanduser(identifier.strip()) if identifier else os.getcwd()
    try:
        proc = subprocess.run(
            [
                "git", "-C", base, "rev-parse",
                "--path-format=absolute",
                "--show-toplevel",
                "--git-common-dir",
            ],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as exc:
        die(f"Failed to run git: {exc}")
    if proc.returncode != 0:
        die(f"Not inside a git repository: {base}")
    lines = [line.strip() for line in proc.stdout.splitlines() if line.strip()]
    if not lines:
        die(f"Could not resolve git repository root: {base}")
    if len(lines) > 1:
        common_dir = os.path.realpath(lines[1])
        if os.path.basename(common_dir) == ".git":
            return os.path.dirname(common_dir)
    return lines[0]


def resolve_task(state_data, identifier):
    """Resolve a task by ID, legacy alias, ID prefix, or title match."""
    tasks = state_data.get("board_tasks", {})
    aliases = state_data.get("task_id_aliases", {})

    # Exact legacy alias match.  Aliases take precedence over literal archived
    # rows with the same ID, so stale/missing alias targets fail instead of
    # silently reading the archived row.
    alias_target = aliases.get(identifier, "")
    if alias_target:
        if alias_target in tasks:
            return tasks[alias_target]
        die(f"Task alias target not found: {identifier} -> {alias_target}")

    # Exact ID match
    if identifier in tasks:
        return tasks[identifier]

    ident_lower = identifier.lower()

    # ID/alias prefix match
    prefix_ids = []
    seen_ids = set()
    for legacy_id, target_id in sorted(aliases.items()):
        if legacy_id.startswith(identifier) and target_id in tasks and target_id not in seen_ids:
            prefix_ids.append(target_id)
            seen_ids.add(target_id)
    hidden_literal_ids = set(aliases)
    for tid in sorted(tasks):
        if tid in hidden_literal_ids:
            continue
        if tid.startswith(identifier) and tid not in seen_ids:
            prefix_ids.append(tid)
            seen_ids.add(tid)
    prefix_matches = [tasks[tid] for tid in prefix_ids]
    if len(prefix_matches) == 1:
        return prefix_matches[0]
    if len(prefix_matches) > 1:
        print(f"Ambiguous prefix \"{identifier}\" matches {len(prefix_matches)} tasks:",
              file=sys.stderr)
        for t in prefix_matches:
            print(f"  {t['id']}  {t.get('task', '')[:50]}", file=sys.stderr)
        die("Use a longer prefix")

    # Title match (case-insensitive)
    title_matches = [t for t in tasks.values()
                     if t.get("task", "").lower() == ident_lower]
    if len(title_matches) == 1:
        return title_matches[0]
    if len(title_matches) > 1:
        print(f"Ambiguous title \"{identifier}\" matches {len(title_matches)} tasks:",
              file=sys.stderr)
        for t in title_matches:
            print(f"  {t['id']}  {t.get('task', '')[:50]}", file=sys.stderr)
        die("Use the ID instead")

    die(f"Task not found: {identifier}")


def detect_context(state_data):
    """Auto-detect group and parent from the current iTerm2 session.

    Reads ITERM_SESSION_ID (format: w0t0p0:GUID), matches the GUID
    against cells in state. Returns (cell, parent_agent, group) or
    (None, None, None) if not in a Torque-managed session.
    """
    iterm_var = os.environ.get("ITERM_SESSION_ID", "")
    if ":" not in iterm_var:
        return None, None, None

    guid = iterm_var.split(":", 1)[1]
    agents = state_data.get("agents", {})

    cell = None
    for c in agents.values():
        if _is_tombstoned_cell(c):
            continue
        if c.get("session_id") == guid:
            cell = c
            break

    if not cell:
        return None, None, None

    group = cell.get("group", "")

    # If we're in a child terminal, the parent agent is parent_id.
    # If we're in an agent session, the agent itself is the parent.
    parent = None
    if cell.get("parent_id"):
        parent = agents.get(cell["parent_id"])
    elif cell.get("cell_type") == "agent":
        parent = cell

    return cell, parent, group


# ---------------------------------------------------------------------------
# Output formatting
# ---------------------------------------------------------------------------

# ANSI helpers — disabled when output is not a TTY
_COLOR = sys.stdout.isatty()


def _c(code, text):
    return f"\033[{code}m{text}\033[0m" if _COLOR else text


def _bold(t):    return _c("1", t)
def _dim(t):     return _c("2", t)
def _green(t):   return _c("32", t)
def _yellow(t):  return _c("33", t)
def _red(t):     return _c("31", t)
def _cyan(t):    return _c("36", t)


_STATUS_DOT = {
    "running":  lambda: _green("●"),
    "idle":     lambda: _dim("●"),
    "stopped":  lambda: _red("■"),
    "error":    lambda: _red("!"),
}


def _status_str(status):
    dot_fn = _STATUS_DOT.get(status, lambda: _dim("●"))
    return f"{dot_fn()} {status}"


def format_status_table(state_data, group_filter=None, window_id=None):
    """Format state as a compact, human-readable table."""
    groups = state_data.get("groups", {})
    agents = state_data.get("agents", {})
    children = state_data.get("children", {})
    lines = []

    # Compute column width from the longest slug across all visible cells
    max_slug = 0
    for c in agents.values():
        if _is_tombstoned_cell(c):
            continue
        slug = c.get("slug", "") or c["id"]
        max_slug = max(max_slug, len(slug))
    # prefix = "  {slug}" (top-level) or "    ↳ {slug}" (child, 6-char indent)
    prefix_w = max(20, max_slug + 8)

    for group_name, cell_ids in groups.items():
        if group_filter and group_name.lower() != group_filter.lower():
            continue

        top_cells = [agents[cid] for cid in cell_ids
                     if cid in agents
                     and not _is_tombstoned_cell(agents[cid])
                     and not agents[cid].get("parent_id")]

        # Window filter: keep agents that have any cell in this window
        if window_id:
            def _in_window(cell):
                if cell.get("window_id") == window_id:
                    return True
                for ch_id in children.get(cell["id"], []):
                    ch = agents.get(ch_id)
                    if ch and ch.get("window_id") == window_id:
                        return True
                return False
            top_cells = [c for c in top_cells if _in_window(c)]
        child_cells_in_group = [agents[cid] for cid in cell_ids
                                if cid in agents
                                and not _is_tombstoned_cell(agents[cid])
                                and agents[cid].get("parent_id")]

        count = len(top_cells)
        if window_id and count == 0:
            continue  # skip empty groups when window-filtering
        label = "agent" if count == 1 else "agents"
        lines.append(f"\n{_bold(group_name)}  {_dim(f'{count} {label}')}")

        for cell in top_cells:
            _append_cell_line(lines, cell, children, agents,
                              prefix_w=prefix_w)

        # Orphan terminals (parent in different group — edge case)
        all_children = {cid for cids in children.values() for cid in cids}
        for cell in child_cells_in_group:
            if cell["id"] not in all_children:
                _append_cell_line(lines, cell, children, agents,
                                  prefix_w=prefix_w)

    if not lines:
        if group_filter:
            lines.append(f"No group matching \"{group_filter}\"")
        else:
            lines.append("No groups configured")

    return "\n".join(lines)


def _append_cell_line(lines, cell, children, agents, is_child=False,
                      prefix_w=20):
    cid = cell["id"]
    slug = cell.get("slug", "") or cid
    status = cell.get("status", "")
    activity = cell.get("activity_detail", "") or cell.get("activity", "")
    branch = cell.get("worktree_branch", "")

    # Build prefix with consistent visible width so status column aligns.
    # Agent:  "  {slug}"       e.g. "  agent-1"
    # Child:  "    ↳ {slug}"   e.g. "    ↳ terminal-1"
    if is_child:
        visible = f"    ↳ {slug}"
        colored = f"    {_dim('↳')} {slug}"
    else:
        visible = f"  {slug}"
        colored = f"  {_dim(slug)}"

    pad = " " * max(1, prefix_w - len(visible))

    parts = [colored + pad, _status_str(status)]
    if activity:
        parts.append(_yellow(activity[:30]))
    if branch:
        parts.append(_cyan(branch))

    lines.append("  ".join(parts))

    if not is_child:
        for child_id in children.get(cid, []):
            child = agents.get(child_id)
            if child and not _is_tombstoned_cell(child):
                _append_cell_line(lines, child, children, agents,
                                  is_child=True, prefix_w=prefix_w)


def format_agent_detail(cell, children_map, agents):
    """Format single agent detail view."""
    lines = []
    ctype = cell.get("cell_type", "agent").title()
    slug = cell.get("slug", "") or cell["id"]
    lines.append(f"{ctype}: {cell['name']} ({slug})")
    lines.append(f"  Group:      {cell.get('group', '')}")
    lines.append(f"  Status:     {cell.get('status', '')}")

    activity = cell.get("activity_detail", "") or cell.get("activity", "")
    if activity:
        lines.append(f"  Activity:   {activity}")

    proc = cell.get("current_process", "")
    if proc:
        lines.append(f"  Process:    {proc}")

    agent_type = cell.get("agent_type", "")
    if agent_type:
        lines.append(f"  Agent type: {agent_type}")

    directory = cell.get("directory", "")
    if directory:
        lines.append(f"  Directory:  {directory}")

    branch = cell.get("current_branch", "")
    if branch:
        lines.append(f"  Branch:     {branch}")

    wt_branch = cell.get("worktree_branch", "")
    if wt_branch:
        lines.append(f"  Worktree:   {cell.get('worktree_path', '')}")
        lines.append(f"  WT branch:  {wt_branch}")
        base = cell.get("worktree_base_branch", "")
        if base:
            lines.append(f"  Base:       {base}")
        diff = cell.get("worktree_diff", {})
        if diff:
            f = diff.get("files", 0)
            ins = diff.get("insertions", 0)
            dels = diff.get("deletions", 0)
            lines.append(f"  Diff:       +{ins} -{dels} ({f} files)")
        cp = cell.get("worktree_checkpoints", 0)
        if cp:
            lines.append(f"  Checkpoints: {cp}")

    tok_in = cell.get("session_tokens_in", 0)
    tok_out = cell.get("session_tokens_out", 0)
    if tok_in or tok_out:
        lines.append(f"  Tokens:     {tok_in:,} in / {tok_out:,} out")

    err = cell.get("error_message", "")
    if err:
        lines.append(f"  Error:      {err}")

    summary = cell.get("last_summary", "")
    if summary:
        # Truncate long summaries
        if len(summary) > 120:
            summary = summary[:117] + "..."
        lines.append(f"  Summary:    {summary}")

    # Children
    child_ids = children_map.get(cell["id"], [])
    if child_ids:
        lines.append(f"  Children:")
        for cid in child_ids:
            child = agents.get(cid)
            if child:
                child_slug = child.get("slug", "") or child["id"]
                lines.append(f"    {child_slug}  {child['name']:<16} "
                             f"{child.get('status', '')}")

    return "\n".join(lines)


# ---------------------------------------------------------------------------
# Minimal YAML parser (stdlib only, covers the action subset)
# ---------------------------------------------------------------------------

def _yaml_parse_value(raw):
    """Parse a scalar YAML value."""
    if raw == "" or raw == "~" or raw == "null":
        return None
    if raw == "true" or raw == "True":
        return True
    if raw == "false" or raw == "False":
        return False
    try:
        return int(raw)
    except ValueError:
        pass
    try:
        return float(raw)
    except ValueError:
        pass
    # Strip surrounding quotes
    if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in ('"', "'"):
        return raw[1:-1]
    return raw


def parse_yaml(text):
    """Parse a simple YAML document into a Python dict.

    Supports: nested dicts (indentation), lists of dicts (- key: val),
    scalars (strings, bools, ints), block scalars (|), quoted strings,
    and comments (#). Does NOT support anchors, tags, flow style, or
    multi-document streams.
    """
    lines = text.split("\n")
    return _yaml_parse_block(lines, 0, 0)[0]


def _yaml_parse_block(lines, idx, base_indent):
    """Parse a YAML block starting at line idx with given base indent.
    Returns (result_dict_or_list, next_line_idx).
    """
    result = {}
    while idx < len(lines):
        line = lines[idx]
        stripped = line.lstrip()

        # Skip blanks and comments
        if not stripped or stripped.startswith("#"):
            idx += 1
            continue

        indent = len(line) - len(stripped)
        if indent < base_indent:
            break  # dedented — return to parent

        # List item
        if stripped.startswith("- "):
            # We're in a list — switch to list parsing
            lst, idx = _yaml_parse_list(lines, idx, indent)
            return lst, idx

        # Key: value pair
        colon_pos = stripped.find(":")
        if colon_pos == -1:
            idx += 1
            continue

        key = stripped[:colon_pos].strip()
        rest = stripped[colon_pos + 1:].strip()

        # Strip inline comments (but not inside quoted strings)
        if rest and rest[0] not in ('"', "'", "|", ">"):
            comment_pos = rest.find(" #")
            if comment_pos >= 0:
                rest = rest[:comment_pos].strip()

        if rest == "|":
            # Block scalar — collect indented lines
            val, idx = _yaml_parse_block_scalar(lines, idx + 1, indent)
            result[key] = val
        elif rest == "":
            # Nested mapping or list
            idx += 1
            child, idx = _yaml_parse_block(lines, idx, indent + 1)
            result[key] = child
        else:
            result[key] = _yaml_parse_value(rest)
            idx += 1

    return result, idx


def _yaml_parse_list(lines, idx, base_indent):
    """Parse a YAML list starting at line idx."""
    result = []
    while idx < len(lines):
        line = lines[idx]
        stripped = line.lstrip()

        if not stripped or stripped.startswith("#"):
            idx += 1
            continue

        indent = len(line) - len(stripped)
        if indent < base_indent:
            break
        if indent > base_indent:
            idx += 1
            continue

        if not stripped.startswith("- "):
            break

        item_str = stripped[2:]  # after "- "

        # Check if it's "- key: val" (dict item)
        colon_pos = item_str.find(":")
        if colon_pos > 0:
            # Dict item — parse this and any continuation lines
            item = {}
            key = item_str[:colon_pos].strip()
            rest = item_str[colon_pos + 1:].strip()
            if rest:
                item[key] = _yaml_parse_value(rest)
            else:
                item[key] = None
            idx += 1

            # Collect additional keys at deeper indent
            while idx < len(lines):
                cline = lines[idx]
                cstripped = cline.lstrip()
                if not cstripped or cstripped.startswith("#"):
                    idx += 1
                    continue
                cindent = len(cline) - len(cstripped)
                if cindent <= base_indent:
                    break
                cp = cstripped.find(":")
                if cp > 0:
                    ck = cstripped[:cp].strip()
                    cv = cstripped[cp + 1:].strip()
                    item[ck] = _yaml_parse_value(cv) if cv else None
                idx += 1

            result.append(item)
        else:
            # Simple scalar list item
            result.append(_yaml_parse_value(item_str))
            idx += 1

    return result, idx


def _yaml_parse_block_scalar(lines, idx, parent_indent):
    """Parse a YAML block scalar (lines after |)."""
    collected = []
    block_indent = None
    while idx < len(lines):
        line = lines[idx]
        if line.strip() == "":
            collected.append("")
            idx += 1
            continue
        indent = len(line) - len(line.lstrip())
        if indent <= parent_indent:
            break
        if block_indent is None:
            block_indent = indent
        collected.append(line[block_indent:] if indent >= block_indent
                         else line.lstrip())
        idx += 1
    # Strip trailing blank lines
    while collected and collected[-1] == "":
        collected.pop()
    return "\n".join(collected), idx


# ---------------------------------------------------------------------------
# Specialization utilities
# ---------------------------------------------------------------------------

GLOBAL_SPECIALIZATIONS_DIR = os.path.expanduser("~/.torque/specializations")


def find_specializations_dirs():
    """Return specialization directories in priority order (project, user)."""
    dirs = []
    d = os.getcwd()
    while True:
        candidate = os.path.join(d, ".torque", "specializations")
        if os.path.isdir(candidate):
            dirs.append(candidate)
            break
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    if os.path.isdir(GLOBAL_SPECIALIZATIONS_DIR) \
            and GLOBAL_SPECIALIZATIONS_DIR not in dirs:
        dirs.append(GLOBAL_SPECIALIZATIONS_DIR)
    return dirs


def find_specializations_dir():
    dirs = find_specializations_dirs()
    return dirs[0] if dirs else None


def _spec_path(name, dirs=None):
    for tdir in (dirs or find_specializations_dirs()):
        for suffix in ("", ".yaml", ".yml"):
            path = os.path.join(tdir, name + suffix)
            if os.path.isfile(path):
                return path
    return None


def list_specializations_local():
    """List specializations. Returns list of {name, description, global}."""
    seen = {}
    for tdir in find_specializations_dirs():
        is_global = (tdir == GLOBAL_SPECIALIZATIONS_DIR)
        if not os.path.isdir(tdir):
            continue
        for fname in sorted(os.listdir(tdir)):
            if not fname.endswith((".yaml", ".yml")):
                continue
            name = fname.rsplit(".", 1)[0]
            if name in seen:
                continue
            path = os.path.join(tdir, fname)
            try:
                with open(path) as f:
                    spec = parse_yaml(f.read()) or {}
                desc = spec.get("description", "")
            except Exception:
                desc = "(parse error)"
            seen[name] = {
                "name": name,
                "description": desc,
                "global": is_global,
                "path": path,
            }
    return sorted(seen.values(), key=lambda t: t["name"])


def load_specialization_local(name):
    """Load a specialization by name, returning its parsed dict or None."""
    path = _spec_path(name)
    if not path:
        return None
    try:
        with open(path) as f:
            return parse_yaml(f.read()) or {}
    except Exception as exc:
        die(f"Failed to parse specialization {name}: {exc}")


# ---------------------------------------------------------------------------
# Action utilities
# ---------------------------------------------------------------------------

GLOBAL_ACTIONS_DIR = os.path.expanduser("~/.torque/actions")


def find_actions_dirs():
    """Return action directories in priority order.

    Project-local (.torque/actions/ walking up from cwd) first,
    then global (~/.torque/actions/). Project actions win on collision.
    """
    dirs = []
    d = os.getcwd()
    while True:
        candidate = os.path.join(d, ".torque", "actions")
        if os.path.isdir(candidate):
            dirs.append(candidate)
            break
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    if os.path.isdir(GLOBAL_ACTIONS_DIR) \
            and GLOBAL_ACTIONS_DIR not in dirs:
        dirs.append(GLOBAL_ACTIONS_DIR)
    return dirs


def find_actions_dir():
    """Return highest-priority actions directory, or None."""
    dirs = find_actions_dirs()
    return dirs[0] if dirs else None


def load_action(name):
    """Load an action by name. Returns parsed dict or dies."""
    for tdir in find_actions_dirs():
        for suffix in ("", ".yaml", ".yml"):
            path = os.path.join(tdir, name + suffix)
            if os.path.isfile(path):
                with open(path) as f:
                    return parse_yaml(f.read())

    available = list_actions()
    if available:
        names = ", ".join(t["name"] for t in available)
        die(f"Action \"{name}\" not found\n"
            f"  Available: {names}")
    else:
        die(f"Action \"{name}\" not found\n"
            "  No actions in .torque/actions/ or ~/.torque/actions/")


def list_actions():
    """List all actions. Returns list of {name, description, global}."""
    seen = {}
    for tdir in find_actions_dirs():
        is_global = (tdir == GLOBAL_ACTIONS_DIR)
        for fname in sorted(os.listdir(tdir)):
            if not fname.endswith((".yaml", ".yml")):
                continue
            name = fname.rsplit(".", 1)[0]
            if name in seen:
                continue  # project-local wins
            path = os.path.join(tdir, fname)
            try:
                with open(path) as f:
                    act = parse_yaml(f.read())
                desc = act.get("description", "")
            except Exception:
                desc = "(parse error)"
            seen[name] = {"name": name, "description": desc,
                          "global": is_global}
    return sorted(seen.values(), key=lambda t: t["name"])


def render_prompt(action, task, agent_name="", agent_id="",
                  branch="", directory=""):
    """Render an action's prompt with variable substitution."""
    prompt = action.get("prompt", "") or action.get("task", "${TASK}")
    prompt = prompt.replace("${TASK}", task)
    prompt = prompt.replace("${AGENT_NAME}", agent_name)
    prompt = prompt.replace("${AGENT_ID}", agent_id)
    prompt = prompt.replace("${BRANCH}", branch)
    prompt = prompt.replace("${DIRECTORY}", directory)
    return prompt


def wait_for_boot(cell_id, port, timeout=15):
    """Poll until agent has a session and is running."""
    t0 = time.time()
    while time.time() - t0 < timeout:
        time.sleep(0.5)
        state_data = get_state(port)
        cell = state_data.get("agents", {}).get(cell_id)
        if cell and cell.get("session_id") and cell.get("status") != "stopped":
            return cell
    return None


def task_slug(description, max_len=20):
    """Generate a short slug from a task description."""
    import re
    slug = re.sub(r"[^a-z0-9]+", "-", description.lower()).strip("-")
    if len(slug) > max_len:
        slug = slug[:max_len].rsplit("-", 1)[0]
    return slug


# ---------------------------------------------------------------------------
# Subcommand handlers
# ---------------------------------------------------------------------------

def cmd_daemon_status(args):
    port = _resolve_daemon_status_port(args)
    if not _daemon_port_is_open(port):
        _print_daemon_status_line("Daemon", "not running")
        sys.exit(1)

    data = check_ok(api_call("get_config", port=port))
    runtime = data.get("runtime", {}) or {}
    runtime_port = runtime.get("port") or port
    data_dir = str(runtime.get("data_dir", "") or "").strip()
    profile = (
        str(runtime.get("profile", "") or "").strip()
        or str(data.get("current_profile", "") or "").strip()
        or "(default)"
    )
    version = str(runtime.get("version", "") or "").strip() or _read_version_file()
    uptime = _format_uptime(runtime.get("started_at"))
    logs = _daemon_log_path(runtime)

    _print_daemon_status_line("Daemon", "running")
    _print_daemon_status_line("PID", _daemon_pid(runtime, runtime_port))
    _print_daemon_status_line("Port", runtime_port)
    _print_daemon_status_line("Profile", profile)
    if data_dir:
        _print_daemon_status_line("Data", data_dir)
    if uptime:
        _print_daemon_status_line("Uptime", uptime)
    if version:
        _print_daemon_status_line("Version", version)
    if logs:
        _print_daemon_status_line("Logs", logs)


def cmd_daemon_stop(args):
    port = _resolve_daemon_port(args)
    timeout = getattr(args, "timeout", 10.0)

    if getattr(args, "force", False):
        _force_stop_daemon(port, timeout)
        return

    if not _daemon_port_is_open(port):
        _daemon_stop_error(
            f"Cannot connect to Torque daemon on localhost:{port}",
            2,
        )

    try:
        resp = api_call("stop", port=port)
    except SystemExit as exc:
        # If the daemon accepted the stop but closed before urlopen completed,
        # treat a freed port as success; otherwise normalize connection/API
        # failures to this command's documented connection error exit code.
        if not _daemon_port_is_open(port):
            print(f"Torque daemon stopped (port {port} freed).")
            return
        code = exc.code if isinstance(exc.code, int) else 2
        sys.exit(2 if code else 0)

    if not resp:
        _daemon_stop_error("Empty response from daemon", 2)
    if not resp.get("ok"):
        _daemon_stop_error(resp.get("error", "Unknown error"), 2)
    data = resp.get("data", {}) or {}
    message = str(data.get("message", "") or "").strip() if isinstance(data, dict) else ""
    if message:
        print(message)
    else:
        print("Torque daemon stopping")

    if _wait_for_daemon_stop(port, timeout=timeout):
        print(f"Torque daemon stopped (port {port} freed).")
        return
    _daemon_stop_error(
        f"Timed out waiting for Torque daemon to stop on port {port}.",
        1,
    )


def cmd_status(args):
    state_data = get_state(args.port)

    if args.identifier:
        cell = resolve_cell(state_data, args.identifier)
        agents = state_data.get("agents", {})
        children = state_data.get("children", {})
        if args.json:
            print(json.dumps(cell, indent=2))
        else:
            print(format_agent_detail(cell, children, agents))
    else:
        # Default: filter to current window unless --all
        window_id = None
        if not args.all and not args.group:
            ctx_cell, _, _ = detect_context(state_data)
            if ctx_cell:
                window_id = ctx_cell.get("window_id", "")
        if args.json:
            print(json.dumps(state_data, indent=2))
        else:
            print(format_status_table(state_data, args.group,
                                      window_id))


