def cmd_ai_context(args):
    cell_id = os.environ.get("TORQUE_CELL_ID", "")
    # Use local state (works offline)
    st = get_state_local(args.port)

    if cell_id:
        cell = st.get("agents", {}).get(cell_id)
    else:
        cell, _, _ = detect_context(st)

    if not cell:
        die("Cannot identify agent — not in a Torque-managed session")

    # Find linked tasks
    tasks = st.get("board_tasks", {})
    linked = [t for t in tasks.values()
              if t.get("agent_id") == cell["id"]]

    if args.json:
        print(json.dumps({"agent": cell, "tasks": linked}, indent=2))
        return

    # Human-readable summary
    slug = cell.get("slug", "") or cell["id"]
    print(f"Agent: {cell['name']} ({slug})")
    print(f"  Group:    {cell.get('group', '')}")
    print(f"  Status:   {cell.get('status', '')}")

    agent_type = cell.get("agent_type", "")
    if agent_type:
        print(f"  Type:     {agent_type}")

    directory = cell.get("directory", "")
    if directory:
        print(f"  Dir:      {directory}")

    wt_branch = cell.get("worktree_branch", "")
    if wt_branch:
        print(f"  Worktree: {cell.get('worktree_path', '')}"
              f"  ({wt_branch})")
        base = cell.get("worktree_base_branch", "")
        if base:
            print(f"  Base:     {base}")

    if not linked:
        print("\n  No linked tasks")
    else:
        for t in linked:
            tslug = t.get("slug", "") or t["id"][:6]
            print(f"\nTask: {t.get('task', '')}")
            print(f"  Slug:     {tslug}")
            print(f"  Lane:     {t.get('lane', '')}")
            if t.get("action_name"):
                print(f"  Action:   {t['action_name']}")
            if t.get("labels"):
                print(f"  Labels:   {', '.join(t['labels'])}")
            if t.get("external_url"):
                print(f"  PR:       {t['external_url']}")


def cmd_ai_derive(args):
    cell, task = _resolve_self_and_task(args)
    kwargs = {"cell_id": cell["id"], "action": "derive",
              "message": args.description}
    if getattr(args, "context", None):
        kwargs["description"] = args.context
    if task:
        kwargs["task_id"] = task["id"]
    if args.action:
        kwargs["action_name"] = args.action
    if args.var:
        tvars = {}
        for kv in args.var:
            k, _, v = kv.partition("=")
            if k:
                tvars[k] = v
        if tvars:
            kwargs["action_vars"] = tvars
    if args.group:
        kwargs["group"] = args.group
    resp = api_call("ai_report", port=args.port, **kwargs)
    data = check_ok(resp)
    new_tid = data.get("task_id", "")
    new_aid = data.get("agent_id", "")
    act = f" (action: {args.action})" if args.action else ""
    print(f"Derived task {new_tid}{act}")
    if new_aid:
        print(f"  Agent: {new_aid}")


