    print(f"Unpinned: {entry.get('id', args.entry_id)}")


def cmd_engineer_journal(args):
    """Read engineer journal entries from SQLite."""
    st = get_state_local(args.port)
    group = getattr(args, "group", "")
    # Auto-detect group: find one with a engineer_agent_id
    if not group:
        for gn, gs in st.get("group_settings", {}).items():
            if isinstance(gs, dict) and gs.get("engineer_agent_id"):
                group = gn
                break
    if not group:
        _die("No engineer found. Use -g to specify a group.")

    # Try reading from daemon API first, fallback to SQLite
    tail = getattr(args, "tail", 20) or 20
    entry_type = getattr(args, "type", "") or ""
    def _read_journal(conn):
        sql = ("SELECT id, group_name, timestamp, entry_type, entry "
               "FROM engineer_journal WHERE group_name=?")
        params = [group]
        if entry_type:
            sql += " AND entry_type=?"
            params.append(entry_type)
        sql += " ORDER BY id DESC LIMIT ?"
        params.append(tail)
        rows = conn.execute(sql, params).fetchall()
        return [{"id": r[0], "group": r[1], "timestamp": r[2],
                 "type": r[3], "entry": r[4]} for r in rows]

    if _db_available():
        try:
            entries = _db_read(_read_journal)
        except Exception:
            entries = []
    else:
        try:
            resp = api_call("engineer_journal_read", port=args.port,
                            group=group, tail=tail, entry_type=entry_type)
            data = check_ok(resp)
            entries = data.get("entries", [])
        except Exception:
            _die("Cannot read journal: daemon not running and "
                 "torque.db not found")

    if not entries:
        print("No journal entries found.")
        return

    if getattr(args, "json", False):
        print(json.dumps(entries, indent=2))
        return

    import time as _time
    # Print newest-last for terminal readability
    for e in reversed(entries):
        ts = _time.strftime("%Y-%m-%d %H:%M",
                            _time.localtime(e["timestamp"]))
        etype = e.get("type", "?")
        entry_text = e.get("entry", "")
        print(f"\n  [{etype}] {ts}")
        for line in entry_text.split("\n"):
            print(f"    {line}")


def cmd_task_resolve(args):
    st = get_state_local(args.port)
    task = resolve_task(st, args.identifier)
    if "torque:human" not in task.get("labels", []):
        _die("Not an ask task (missing 'torque:human' label)")
    answer = args.answer
    if not answer:
        # Read from stdin or prompt
        import sys
        if not sys.stdin.isatty():
            answer = sys.stdin.read().strip()
        else:
            print(f"Question: {task.get('task', '')}")
            print("Enter your answer (Ctrl+D to finish):")
            try:
                answer = sys.stdin.read().strip()
            except EOFError:
                answer = ""
    if not answer:
        _die("Answer is required")
    resp = api_call("resolve_ask", port=args.port,
                    id=task["id"], answer=answer)
    check_ok(resp)
    print(f"Resolved: answer sent to parent agent.")


def cmd_task_chain(args):
    st = get_state_local(args.port)
    task = resolve_task(st, args.identifier)
    # Get chain via API if daemon is running, else walk locally
    root_id = task.get("pipeline_root_id") or task["id"]
    tasks = st.get("board_tasks", {})
    chain = [t for t in tasks.values()
             if (t.get("pipeline_root_id") == root_id)
             or (t["id"] == root_id)]
    chain.sort(key=lambda t: (t.get("pipeline_depth", 0),
                               t.get("created_at", "")))

    if not chain or (len(chain) == 1
                     and not chain[0].get("parent_task_id")):
        print("This task is not part of a pipeline.")
        return

    if args.json:
        print(json.dumps({"root_id": root_id, "chain": chain}, indent=2))
        return

    max_depth = max(t.get("pipeline_depth", 0) for t in chain)
    print(f"{_bold('Pipeline')}: {root_id} (depth {max_depth})\n")
    for t in chain:
        depth = t.get("pipeline_depth", 0)
        lane = t.get("lane", "")
        tid = t.get("slug") or t["id"][:8]
        task_text = t.get("task", "")[:50]
        agent = ""
        if t.get("agent_id"):
            agents = st.get("agents", {})
            a = agents.get(t["agent_id"])
            if a:
                agent = f"  {_dim(a.get('slug') or a.get('name', ''))}"

        if lane == ARCHIVED_LANE:
            icon = _dim("□")
        elif lane == "Done":
            icon = _green("✓")
        elif "torque:error" in t.get("labels", []):
            icon = _red("✕")
        elif lane == "Backlog":
            icon = "○"
        else:
            icon = _yellow("→")

        status = t.get("status", "")
        status_str = f"  [{status}]" if status else ""
        indent = "  " * depth
        print(f"  {icon} {indent}[{depth}] {task_text:<40} "
              f"{_dim(lane)}{status_str}{agent}")


def cmd_pipeline_list(args):
    resp = api_call("discover_pipelines", port=args.port,
                    group=args.group or "")
    data = check_ok(resp)
    pipelines = data.get("pipelines", [])
    if not pipelines:
        print("No pipelines found (actions need 'transitions' field)")
        return

    if args.json:
        print(json.dumps(pipelines, indent=2))
        return

    print(f"{_bold('Pipelines')}\n")
    for p in pipelines:
        edge_strs = []
        for e in p.get("edges", []):
            edge_strs.append(f"{e['from']} → {e['to']}")
        summary = ", ".join(edge_strs) if edge_strs else "(no edges)"
        print(f"  {_bold(p['name']):<20} {_dim(summary)}")


def cmd_pipeline_show(args):
    resp = api_call("discover_pipelines", port=args.port,
                    group=args.group or "")
    data = check_ok(resp)
    pipelines = data.get("pipelines", [])
    match = [p for p in pipelines if p["name"] == args.name]
    if not match:
        die(f"Pipeline '{args.name}' not found")
    p = match[0]

    if args.json:
        print(json.dumps(p, indent=2))
        return

    print(f"{_bold('Pipeline')}: {p['name']} "
          f"({len(p.get('actions', []))} actions)\n")

    # Build adjacency for display
    adj = {}
    for e in p.get("edges", []):
        adj.setdefault(e["from"], []).append(e)

    for tname in sorted(p.get("actions", [])):
        edges = adj.get(tname, [])
        print(f"  {_bold(tname)}")
        for e in edges:
            when = f'  "{e["when"]}"' if e.get("when") else ""
            print(f"    → {e['to']}{_dim(when)}")
        if not edges:
            print(f"    {_dim('(terminal — no transitions)')}")
        print()


