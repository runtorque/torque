def cmd_board_list(args):
    st = get_state_local(args.port)
    lanes = st.get("board_lanes", [])
    tasks = st.get("board_tasks", {})
    lane_filter = args.lane if hasattr(args, "lane") and args.lane else None

    # Auto-detect group from TORQUE_CELL_ID / ITERM_SESSION_ID unless --all
    show_all = getattr(args, "all", False)
    group_filter = getattr(args, "group", None)
    if not show_all and not group_filter:
        cell_id = os.environ.get("TORQUE_CELL_ID", "")
        if cell_id:
            cell = st.get("agents", {}).get(cell_id)
            if cell:
                group_filter = cell.get("group", "")
        else:
            cell, _parent, grp = detect_context(st)
            if grp:
                group_filter = grp

    if args.json:
        import json as _j
        visible_lanes = [
            lane for lane in lanes
            if lane != ARCHIVED_LANE or getattr(args, "archived", False)
            or (lane_filter and lane.lower() == lane_filter.lower())
        ]
        filtered_tasks = {
            tid: t for tid, t in tasks.items()
            if not _task_is_archived(t) or getattr(args, "archived", False)
            or (lane_filter and t.get("lane", "").lower() == lane_filter.lower())
        }
        print(_j.dumps({"lanes": visible_lanes, "tasks": filtered_tasks}, indent=2))
        return

    for lane in lanes:
        if lane == ARCHIVED_LANE and not getattr(args, "archived", False) \
                and not (lane_filter and lane.lower() == lane_filter.lower()):
            continue
        if lane_filter and lane.lower() != lane_filter.lower():
            continue
        lane_tasks = sorted(
            [t for t in tasks.values()
             if t["lane"] == lane
             and (lane != ARCHIVED_LANE or getattr(args, "archived", False)
                  or (lane_filter and lane.lower() == lane_filter.lower()))
             and (not group_filter or t.get("group") == group_filter)],
            key=lambda t: t.get("position", 0),
            reverse=True,
        )
        print(f"\n  {_bold(lane)} ({len(lane_tasks)})")
        if not lane_tasks:
            print(f"    {_dim('(empty)')}")
        for t in lane_tasks:
            agent_str = ""
            if t.get("agent_id"):
                a = st.get("agents", {}).get(t["agent_id"])
                if a:
                    agent_str = f" {_cyan('→ ' + a['name'])}"
            tslug = _dim(t.get("slug", "") or t["id"][:6])
            print(f"    {tslug}  {t.get('task', t.get('title', ''))}{agent_str}")
    print()


def cmd_board_add(args):
    state_data = get_state_local(args.port)
    group = args.group
    if not group:
        _cell, _parent, group = detect_context(state_data)
        if not group:
            groups = state_data.get("groups", {})
            group = next(iter(groups), "")
    resp = api_call("board_add_task", port=args.port,
                    task=args.task, group=group, lane=args.lane or "")
    data = check_ok(resp)
    if args.json:
        import json as _j
        print(_j.dumps(data, indent=2))
    else:
        print(f"Task added to {args.lane or 'first lane'}")


def cmd_board_import(args):
    state_data = get_state_local(args.port)
    group = args.group
    if not group:
        _cell, _parent, group = detect_context(state_data)
        if not group:
            groups = state_data.get("groups", {})
            group = next(iter(groups), "")
    resp = api_call(
        "external_import_task",
        port=args.port,
        ref=args.ref,
        group=group,
        lane=args.lane or "",
        provider=args.provider or "",
        title=args.title or "",
        description=args.description or "",
    )
    data = check_ok(resp)
    print(f"Imported external ticket as {data.get('task_id', 'task')}")


def cmd_board_link(args):
    st = get_state_local(args.port)
    match = resolve_task(st, args.identifier)
    payload = {
        "id": match["id"],
        "provider": "",
        "external_id": "",
        "external_url": "",
        "ref": "",
    } if args.clear else {
        "id": match["id"],
        "provider": args.provider or match.get("provider", ""),
        "external_id": args.external_id or match.get("external_id", ""),
        "external_url": args.url or match.get("external_url", ""),
        "ref": args.ref or "",
    }
    resp = api_call("external_link_task", port=args.port, **payload)
    data = check_ok(resp)
    if args.clear:
        print(f"Unlinked external issue from \"{match.get('task', '')}\"")
    else:
        provider = data.get("provider", "")
        external_id = data.get("external_id", "")
        suffix = f"{provider}:{external_id}" if provider and external_id else external_id or data.get("external_url", "")
        print(f"Linked \"{match.get('task', '')}\" to {suffix or 'external issue'}")


def cmd_board_open(args):
    st = get_state_local(args.port)
    match = resolve_task(st, args.identifier)
    resp = api_call("external_open_task", port=args.port, id=match["id"])
    data = check_ok(resp)
    url = data.get("url", "")
    if not url:
        die("No external URL available")
    try:
        subprocess.run(["open", url], check=False)
    except Exception:
        pass
    print(url)


