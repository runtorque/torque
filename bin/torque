# -- Agent history commands -------------------------------------------------

def db_read_agent_history(status_filter="", limit=50):
    """Read agent history directly from SQLite."""
    def _query(conn):
        sql = (
            'SELECT id, name, slug, "group", agent_type, template, '
            'created_at, removed_at, worktree_branch, total_tokens_in, '
            'total_tokens_out, total_tasks, status FROM agent_history')
        params = []
        if status_filter:
            sql += ' WHERE status=?'
            params.append(status_filter)
        sql += (' ORDER BY CASE WHEN status=\'active\' THEN 0 ELSE 1 END,'
                ' created_at DESC LIMIT ?')
        params.append(limit)
        rows = conn.execute(sql, params).fetchall()
        cols = ["id", "name", "slug", "group", "agent_type", "template",
                "created_at", "removed_at", "worktree_branch",
                "total_tokens_in", "total_tokens_out", "total_tasks",
                "status"]
        return [dict(zip(cols, r)) for r in rows]
    return _db_read(_query)


def db_read_agent_history_detail(agent_id):
    """Read a single agent history record + tasks + messages."""
    def _query(conn):
        c = conn.cursor()
        row = c.execute(
            'SELECT id, name, slug, "group", agent_type, template, '
            'created_at, removed_at, worktree_branch, total_tokens_in, '
            'total_tokens_out, total_tasks, status '
            'FROM agent_history WHERE id=?', (agent_id,)).fetchone()
        if not row:
            return None
        cols = ["id", "name", "slug", "group", "agent_type", "template",
                "created_at", "removed_at", "worktree_branch",
                "total_tokens_in", "total_tokens_out", "total_tasks",
                "status"]
        record = dict(zip(cols, row))
        # Tasks
        trows = c.execute(
            'SELECT id, agent_id, task_id, task_title, started_at, '
            'completed_at, outcome FROM agent_tasks '
            'WHERE agent_id=? ORDER BY started_at DESC',
            (agent_id,)).fetchall()
        tcols = ["id", "agent_id", "task_id", "task_title",
                 "started_at", "completed_at", "outcome"]
        record["tasks"] = [dict(zip(tcols, r)) for r in trows]
        # Messages
        mrows = c.execute(
            'SELECT id, agent_id, task_id, timestamp, action, message '
            'FROM agent_messages WHERE agent_id=? '
            'ORDER BY timestamp DESC LIMIT 100',
            (agent_id,)).fetchall()
        mcols = ["id", "agent_id", "task_id", "timestamp",
                 "action", "message"]
        record["messages"] = [dict(zip(mcols, r)) for r in mrows]
        return record
    return _db_read(_query)


def db_read_agent_messages(agent_id, limit=50):
    """Read agent messages from SQLite."""
    def _query(conn):
        rows = conn.execute(
            'SELECT id, agent_id, task_id, timestamp, action, message '
            'FROM agent_messages WHERE agent_id=? '
            'ORDER BY timestamp DESC LIMIT ?',
            (agent_id, limit)).fetchall()
        cols = ["id", "agent_id", "task_id", "timestamp",
                "action", "message"]
        return [dict(zip(cols, r)) for r in rows]
    return _db_read(_query)


def _resolve_agent_history(identifier):
    """Resolve an agent from history by ID, slug, or name prefix."""
    records = db_read_agent_history(limit=500)
    # Exact ID
    for r in records:
        if r["id"] == identifier:
            return r
    # Slug match
    for r in records:
        if r.get("slug") and r["slug"] == identifier:
            return r
    # Name match (case-insensitive)
    ident_lower = identifier.lower()
    for r in records:
        if r["name"].lower() == ident_lower:
            return r
    # ID prefix
    for r in records:
        if r["id"].startswith(identifier):
            return r
    die(f"Agent not found in history: {identifier}")


def _fmt_ts(ts):
    """Format a Unix timestamp as a readable date string."""
    if not ts:
        return "-"
    from datetime import datetime
    dt = datetime.fromtimestamp(ts)
    return dt.strftime("%Y-%m-%d %H:%M")


def _fmt_tokens(n):
    """Format token count with K/M suffix."""
    if not n:
        return "-"
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}K"
    return str(n)


def cmd_agent_history_list(args):
    if not _db_available():
        die("SQLite database not found — is Torque installed?")
    status = getattr(args, "status", "") or ""
    limit = getattr(args, "limit", 50) or 50
    records = db_read_agent_history(status_filter=status, limit=limit)
    if not records:
        print("No agent history records found.")
        return
    # Print table
    print(f"{'Name':<25} {'Type':<12} {'Group':<15} {'Status':<10} "
          f"{'Created':<18} {'Tasks':>5} {'Tokens In':>10} {'Tokens Out':>10}")
    print("-" * 115)
    for r in records:
        print(f"{r['name'][:24]:<25} {r.get('agent_type', '')[:11]:<12} "
              f"{r.get('group', '')[:14]:<15} {r['status']:<10} "
              f"{_fmt_ts(r['created_at']):<18} "
              f"{r.get('total_tasks', 0):>5} "
              f"{_fmt_tokens(r.get('total_tokens_in', 0)):>10} "
              f"{_fmt_tokens(r.get('total_tokens_out', 0)):>10}")


def cmd_agent_history_show(args):
    if not _db_available():
        die("SQLite database not found — is Torque installed?")
    rec = _resolve_agent_history(args.identifier)
    detail = db_read_agent_history_detail(rec["id"])
    if not detail:
        die(f"Agent not found in history: {args.identifier}")

    print(f"Agent: {detail['name']} ({detail['id']})")
    print(f"  Status:    {detail['status']}")
    print(f"  Type:      {detail.get('agent_type') or '-'}")
    print(f"  Group:     {detail.get('group') or '-'}")
    print(f"  Template:  {detail.get('template') or '-'}")
    print(f"  Branch:    {detail.get('worktree_branch') or '-'}")
    print(f"  Created:   {_fmt_ts(detail['created_at'])}")
    print(f"  Removed:   {_fmt_ts(detail.get('removed_at'))}")
    print(f"  Tokens:    {_fmt_tokens(detail.get('total_tokens_in', 0))} in"
          f" / {_fmt_tokens(detail.get('total_tokens_out', 0))} out")
    print(f"  Tasks:     {detail.get('total_tasks', 0)}")

    tasks = detail.get("tasks", [])
    if tasks:
        print(f"\nTasks ({len(tasks)}):")
        for t in tasks:
            outcome = t.get("outcome") or "in-progress"
            completed = _fmt_ts(t.get("completed_at"))
            print(f"  [{outcome:<12}] {t['task_title'][:60]}"
                  f"  (started {_fmt_ts(t['started_at'])}"
                  f", completed {completed})")

    messages = detail.get("messages", [])
    if messages:
        print(f"\nRecent messages ({len(messages)}):")
        for m in messages[:20]:
            print(f"  {_fmt_ts(m['timestamp'])} [{m['action']:<10}] "
                  f"{m.get('message', '')[:80]}")


def cmd_agent_history_messages(args):
    if not _db_available():
        die("SQLite database not found — is Torque installed?")
    rec = _resolve_agent_history(args.identifier)
    limit = getattr(args, "limit", 50) or 50
    messages = db_read_agent_messages(rec["id"], limit=limit)
    if not messages:
        print(f"No messages found for agent \"{rec['name']}\".")
        return
    print(f"Messages for \"{rec['name']}\" ({len(messages)}):")
    for m in messages:
        print(f"  {_fmt_ts(m['timestamp'])} [{m['action']:<10}] "
              f"{m.get('message', '')[:100]}")


# -- Terminal commands ------------------------------------------------------

def cmd_terminal_add(args):
    kwargs = {
        "name": args.name,
        "parent_id": "",
    }
    if args.parent:
        state_data = get_state(args.port)
        parent = resolve_cell(state_data, args.parent)
        kwargs["parent_id"] = parent["id"]
        kwargs["group"] = parent.get("group", "")
    elif args.group:
        kwargs["group"] = args.group
    else:
        # Auto-detect from current iTerm2 session
        state_data = get_state(args.port)
        _cell, parent, group = detect_context(state_data)
        if parent:
            kwargs["parent_id"] = parent["id"]
            kwargs["group"] = parent.get("group", "")
        elif group:
            kwargs["group"] = group
        else:
            die("Either --parent (-p) or --group (-g) is required\n"
                "  (auto-detect failed — not in a Torque-managed session)")

    if args.command:
        kwargs["command"] = args.command
    if args.directory:
        kwargs["directory"] = args.directory
    if args.profile:
        kwargs["profile"] = args.profile
    if args.color:
        kwargs["tab_color"] = args.color

    resp = api_call("add_terminal", port=args.port, **kwargs)
    data = check_ok(resp)

    agents = data.get("agents", {})
    match = [c for c in agents.values()
             if c["name"] == args.name and c.get("cell_type") == "terminal"]
    if match:
        cell = match[-1]
        slug = cell.get("slug", "")
        print(f"Terminal \"{args.name}\" created (id: {cell['id']}, slug: {slug})")
    else:
        print(f"Terminal \"{args.name}\" created")


def cmd_terminal_remove(args):
    state_data = get_state(args.port)
    cell = resolve_cell(state_data, args.identifier)
    resp = api_call("remove_agent", port=args.port, id=cell["id"])
    check_ok(resp)
    print(f"Removed \"{cell['name']}\" ({cell.get('slug', '') or cell['id']})")


def cmd_terminal_reparent(args):
    state_data = get_state(args.port)
    cell = resolve_cell(state_data, args.identifier)
    parent_id = ""
    if not args.detach:
        if not args.parent:
            die("Either --parent (-p) or --detach is required")
        parent = resolve_cell(state_data, args.parent)
        parent_id = parent["id"]
    resp = api_call("reparent_terminal", port=args.port,
                    id=cell["id"], parent_id=parent_id)
    check_ok(resp)
    if parent_id:
        print(f"Reparented \"{cell['name']}\" under \"{args.parent}\"")
    else:
        print(f"Detached \"{cell['name']}\"")


# -- Send -------------------------------------------------------------------

def wait_for_idle(cell_id, cell_name, port, interval=2):
    """Poll until the agent finishes its turn.

    Detects turn completion by watching for activity to clear after
    being non-empty (the session_end event clears activity fields).
    Also exits on hard status changes (stopped, error).
    """
    t0 = time.time()
    is_tty = sys.stderr.isatty()
    saw_activity = False

    try:
        while True:
            time.sleep(interval)
            state_data = get_state(port)
            cell = state_data.get("agents", {}).get(cell_id)
            if not cell:
                if is_tty:
                    print(file=sys.stderr)
                print(f"{cell_name} no longer exists", file=sys.stderr)
                return 1

            status = cell.get("status", "")
            activity = (cell.get("activity_detail", "")
                        or cell.get("activity", ""))
            elapsed = int(time.time() - t0)

            if is_tty:
                line = (f"  {_status_str(status)}"
                        f"  {_yellow(activity[:40]) if activity else ''}"
                        f"  {_dim(f'{elapsed}s')}")
                print(f"\r\033[K{line}", end="", file=sys.stderr,
                      flush=True)

            # Track whether the agent ever started working
            if activity:
                saw_activity = True

            # Hard exit: process died or errored
            if status in ("stopped", "error"):
                if is_tty:
                    print(file=sys.stderr)
                return 1

            # Turn complete: activity cleared after we saw it working
            if saw_activity and not activity:
                if is_tty:
                    print(file=sys.stderr)
                summary = cell.get("last_summary", "")
                if summary:
                    print(f"\n{summary}")
                return 0
    except KeyboardInterrupt:
        if is_tty:
            print(file=sys.stderr)
        print("Interrupted", file=sys.stderr)
        return 130


def cmd_send(args):
    state_data = get_state(args.port)
    if args.identifier:
        cell = resolve_cell(state_data, args.identifier)
    else:
        _cell, parent, _group = detect_context(state_data)
        if not parent:
            die("No target specified and auto-detect failed\n"
                "  (not in a Torque-managed session)")
        cell = parent
    text = args.text
    if not text.endswith("\r") and not text.endswith("\n"):
        text += "\r"
    resp = api_call("send_text", port=args.port,
                    id=cell["id"], text=text)
    check_ok(resp)
    print(f"Sent to \"{cell['name']}\"")

    if args.wait:
        rc = wait_for_idle(cell["id"], cell["name"], args.port)
        sys.exit(rc)


