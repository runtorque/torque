    p = ai_sub.add_parser("name",
                           help="Rename agent based on task objective")
    p.add_argument("name", help="Short descriptive name (kebab-case)")
    p.set_defaults(func=cmd_ai_name)

    p = ai_sub.add_parser("context", help="Show current agent context")
    p.set_defaults(func=cmd_ai_context)

    p = ai_sub.add_parser("derive",
                          help="Derive a new task and dispatch next agent")
    p.add_argument("description", help="Short task title for the next step")
    p.add_argument("-d", "--context", help="Longer description / details")
    p.add_argument("-t", "--action", help="Action for the new task")
    p.add_argument("-v", "--var", nargs="+", metavar="KEY=VALUE",
                   help="Action variables")
    p.add_argument("-g", "--group", help="Target group (inherit from task)")
    p.add_argument("task_ref", nargs="?",
                   help="Task slug/ID (auto-detected)")
    p.set_defaults(func=cmd_ai_derive)

    p = ai_sub.add_parser("ask",
                          help="Create a task for human decision")
    p.add_argument("question", help="Question for the human to review")
    p.add_argument("-d", "--description",
                   help="Longer description (question becomes the title)")
    p.add_argument("task_ref", nargs="?",
                   help="Task slug/ID (auto-detected)")
    p.set_defaults(func=cmd_ai_ask)

    p = ai_sub.add_parser("reply",
                          help="Reply to a message from the engineer")
    p.add_argument("message", help="Reply text to send back to the engineer")
    p.add_argument("task_ref", nargs="?",
                   help="Task slug/ID (auto-detected)")
    p.set_defaults(func=cmd_ai_reply)

    # -- memory ------------------------------------------------------------
    mem = sub.add_parser("memory", aliases=["mem"],
                         help="Shared context memory")
    mem.set_defaults(func=None, _sub_parser=mem)
    mem_sub = mem.add_subparsers(dest="memory_cmd")

    p = mem_sub.add_parser("add", help="Publish a shared memory entry")
    p.add_argument("content", help="Memory content")
    p.add_argument("-t", "--type", required=True,
                   choices=["finding", "decision", "warning", "handoff", "note"],
                   help="Entry type")
    p.add_argument("--title", help="Optional short title")
    p.add_argument("--scope",
                   choices=["task", "pipeline", "group", "project"],
                   help="Scope kind (defaults from current agent/task context)")
    p.add_argument("--ref", help="Explicit scope reference")
    p.add_argument("--retention", choices=["durable", "transient"],
                   help="Override retention behavior (defaults from entry type)")
    p.add_argument("--pin", action="store_true", help="Pin this entry")
    p.set_defaults(func=cmd_memory_add)

    p = mem_sub.add_parser("list", aliases=["ls"], help="List shared memory entries")
    p.add_argument("--scope",
                   choices=["task", "pipeline", "group", "project"],
                   help="Scope kind filter")
    p.add_argument("--ref", help="Explicit scope reference")
    p.add_argument("-t", "--type",
                   choices=["finding", "decision", "warning", "handoff", "note"],
                   help="Entry type filter")
    p.add_argument("--search", help="Text search")
    p.add_argument("--link-kind",
                   choices=["task", "agent", "pipeline"],
                   help="Filter by linked target kind")
    p.add_argument("--link-ref", help="Filter by linked target reference")
    p.add_argument("--pinned-only", action="store_true",
                   help="Only show pinned entries")
    p.add_argument("-n", "--limit", type=int, default=20,
                   help="Maximum entries to show")
    p.add_argument("--offset", type=int, default=0,
                   help="Pagination offset")
    p.add_argument("--json", action="store_true", help="JSON output")
    p.set_defaults(func=cmd_memory_list)

    p = mem_sub.add_parser("show", aliases=["get"], help="Show one shared memory entry")
    p.add_argument("entry_id", help="Memory entry ID")
    p.add_argument("--json", action="store_true", help="JSON output")
    p.set_defaults(func=cmd_memory_show)

    p = mem_sub.add_parser("link", help="Link a memory entry to another Torque object")
    p.add_argument("entry_id", help="Memory entry ID")
    p.add_argument("--kind", required=True,
                   choices=["task", "agent", "pipeline"],
                   help="Target kind")
    p.add_argument("--ref", help="Target reference (defaults from current context)")
    p.set_defaults(func=cmd_memory_link)

    p = mem_sub.add_parser("pin", help="Pin a memory entry")
    p.add_argument("entry_id", help="Memory entry ID")
    p.set_defaults(func=cmd_memory_pin)

    p = mem_sub.add_parser("unpin", help="Unpin a memory entry")
    p.add_argument("entry_id", help="Memory entry ID")
    p.set_defaults(func=cmd_memory_unpin)

    # -- task chain ---------------------------------------------------------
    # (added to task subcommand group)

    # -- pipeline -----------------------------------------------------------
    pipe = sub.add_parser("pipeline", aliases=["pl"],
                          help="Pipeline discovery and visualization")
    pipe.set_defaults(func=cmd_pipeline_list, _sub_parser=pipe)
    pipe_sub = pipe.add_subparsers(dest="pipeline_cmd")

    p = pipe_sub.add_parser("list", aliases=["ls"],
                            help="List discovered pipelines")
    p.add_argument("-g", "--group", help="Scope to group")
    p.set_defaults(func=cmd_pipeline_list)

    p = pipe_sub.add_parser("show", help="Show pipeline details")
    p.add_argument("name", help="Pipeline name")
    p.add_argument("-g", "--group", help="Scope to group")
    p.set_defaults(func=cmd_pipeline_show)

    # -- schedule -----------------------------------------------------------
    sch = sub.add_parser("schedule", aliases=["sched"],
                         help="Scheduled task dispatches")
    sch.set_defaults(func=cmd_schedule_list, _sub_parser=sch)
    sch_sub = sch.add_subparsers(dest="schedule_cmd")

    p = sch_sub.add_parser("create", aliases=["c"],
                           help="Create a schedule")
    p.add_argument("name", help="Schedule name")
    p.add_argument("--task", help="Task title template ({date}, {time})")
    p.add_argument("-d", "--context", help="Task description")
    p.add_argument("-g", "--group",
                   help="Target group (auto-detected if in Torque session)")
    p.add_argument("--cron", help="Cron expression (5-field)")
    p.add_argument("--at", help="One-shot time (ISO 8601, +2h, tomorrow 09:00)")
    p.add_argument("-t", "--action", help="Action name")
    p.add_argument("-v", "--var", nargs="+", metavar="KEY=VALUE",
                   help="Action variables")
    p.add_argument("-l", "--labels", help="Comma-separated labels")
    p.add_argument("--tz", help="IANA timezone (default: UTC)")
    p.set_defaults(func=cmd_schedule_create)

    p = sch_sub.add_parser("list", aliases=["ls"],
                           help="List schedules")
    p.set_defaults(func=cmd_schedule_list)

    p = sch_sub.add_parser("show", help="Show schedule details")
    p.add_argument("identifier", help="Schedule ID, slug, or name")
    p.set_defaults(func=cmd_schedule_show)

    p = sch_sub.add_parser("edit", aliases=["e"],
                           help="Edit schedule fields")
    p.add_argument("identifier", help="Schedule ID, slug, or name")
    p.add_argument("--name", help="New schedule name")
    p.add_argument("--task", help="New task template")
    p.add_argument("--cron", help="New cron expression")
    p.add_argument("--at", help="New one-shot time")
    p.add_argument("-t", "--action", help="Set action")
    p.add_argument("-v", "--var", nargs="+", metavar="KEY=VALUE",
                   help="Set action variables")
    p.add_argument("-l", "--labels", help="Comma-separated labels")
    p.add_argument("--tz", help="IANA timezone")
    p.set_defaults(func=cmd_schedule_edit)

    p = sch_sub.add_parser("delete", aliases=["rm"],
                           help="Delete a schedule")
    p.add_argument("identifier", help="Schedule ID, slug, or name")
    p.set_defaults(func=cmd_schedule_delete)

    p = sch_sub.add_parser("enable", help="Enable a schedule")
    p.add_argument("identifier", help="Schedule ID, slug, or name")
    p.set_defaults(func=cmd_schedule_enable)

    p = sch_sub.add_parser("disable", help="Disable a schedule")
    p.add_argument("identifier", help="Schedule ID, slug, or name")
    p.set_defaults(func=cmd_schedule_disable)

    p = sch_sub.add_parser("run", help="Manually trigger a schedule now")
    p.add_argument("identifier", help="Schedule ID, slug, or name")
    p.set_defaults(func=cmd_schedule_run)

    # -- digest ------------------------------------------------------------
    dig = sub.add_parser("digest", aliases=["dg"],
                         help="Per-agent digest controls")
    dig.set_defaults(func=None, _sub_parser=dig)
    dig_sub = dig.add_subparsers(dest="digest_cmd")

    p = dig_sub.add_parser("pause", help="Pause digest delivery for one agent")
    p.add_argument("identifier", help="Agent ID, slug, name, or ID prefix")
    p.set_defaults(func=cmd_digest_pause)

    p = dig_sub.add_parser("resume", help="Resume digest delivery for one agent")
    p.add_argument("identifier", help="Agent ID, slug, name, or ID prefix")
    p.set_defaults(func=cmd_digest_resume)

    # -- logs ---------------------------------------------------------------
    p = sub.add_parser("logs", help="Tail daemon log")
    p.add_argument("-f", "--follow", action="store_true",
                   help="Follow log output")
    p.set_defaults(func=cmd_logs)

    return parser


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = build_parser()
    args = parser.parse_args()

    if not hasattr(args, "func") or args.func is None:
        # Show help for the subcommand (e.g. "torque agent") or top-level
        sub_parser = getattr(args, "_sub_parser", None)
        (sub_parser or parser).print_help()
        sys.exit(1)

    args.func(args)


if __name__ == "__main__":
    main()
