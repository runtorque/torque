    spec = load_specialization_local(args.name)
    if spec is None:
        die(f"Specialization \"{args.name}\" not found")
    if args.json:
        print(json.dumps(spec, indent=2))
        return
    _print_dict(spec)


def cmd_specialization_create(args):
    tdir = None
    if args.scope == "user":
        tdir = GLOBAL_SPECIALIZATIONS_DIR
    else:
        tdir = find_specializations_dir()
        if not tdir:
            root = os.getcwd()
            tdir = os.path.join(root, ".torque", "specializations")
    os.makedirs(tdir, exist_ok=True)
    path = os.path.join(tdir, f"{args.name}.yaml")
    if os.path.exists(path):
        die(f"Specialization \"{args.name}\" already exists at {path}")

    if args.from_file:
        if not os.path.isfile(args.from_file):
            die(f"--from-file source not found: {args.from_file}")
        with open(args.from_file) as f:
            content = f.read()
        try:
            parsed = parse_yaml(content) or {}
        except Exception as exc:
            die(f"Failed to parse source YAML: {exc}")
        if not isinstance(parsed, dict):
            die("Source YAML must be a mapping")
        parsed.setdefault("name", args.name)
        with open(path, "w") as f:
            f.write(content if isinstance(content, str) else "")
    else:
        starter = f"""name: {args.name}
description: ""

priorities:
  - Describe priority one.
  - Describe priority two.

preamble: |
  You are a {args.name}-focused engineer.
"""
        with open(path, "w") as f:
            f.write(starter)
    print(f"Created {path}")


def cmd_specialization_edit(args):
    path = _spec_path(args.name)
    if not path:
        die(f"Specialization \"{args.name}\" not found")
    editor = os.environ.get("EDITOR", "vi")
    try:
        import subprocess
        subprocess.call([editor, path])
    except Exception as exc:
        die(f"Failed to launch editor: {exc}")


def cmd_specialization_delete(args):
    path = _spec_path(args.name)
    if not path:
        die(f"Specialization \"{args.name}\" not found")
    os.remove(path)
    print(f"Deleted {path}")


# -- Logs -------------------------------------------------------------------

def cmd_logs(args):
    if not os.path.isfile(TORQUE_LOG):
        die(f"Log file not found: {TORQUE_LOG}")
    if args.follow:
        os.execvp("tail", ["tail", "-f", TORQUE_LOG])
    else:
        os.execvp("tail", ["tail", "-50", TORQUE_LOG])


def _format_mcp_call_line(call):
    ts = float(call.get("appended_at") or call.get("received_at") or 0)
    stamp = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(ts)) if ts else "unknown-time"
    tool = call.get("tool_name", "") or "<unknown-tool>"
    hook = call.get("hook_event_name", "") or "hook"
    status = "ok" if call.get("success", True) else "error"
    duration = call.get("duration_ms")
    duration_part = f" {duration}ms" if duration is not None else ""
    args = call.get("args")
    if isinstance(args, dict) and args.get("redacted"):
        keys = ", ".join(args.get("arg_keys") or [])
        arg_part = f" args:redacted keys=[{keys}]"
    elif args is not None:
        text = json.dumps(args, sort_keys=True)
        if len(text) > 120:
            text = text[:117] + "..."
        arg_part = f" args:{text}"
    else:
        arg_part = " args:redacted"
    return f"{stamp}  {status:<5} {hook:<16} {tool}{duration_part}{arg_part}"


def cmd_mcp_log(args):
    state_data = get_state(args.port)
    cell = resolve_cell(state_data, args.agent)
    since = None
    if getattr(args, "since_seconds", None):
        since = time.time() - int(args.since_seconds)
    data = check_ok(api_call(
        "mcp_calls",
        port=args.port,
        cell_id=cell["id"],
        tool_name_pattern=args.tool_filter or "mcp__torque__%",
        hook_event_name=args.hook,
        since=since,
        limit=args.limit,
    ))
    calls = data.get("calls") or data.get("events") or []
    if args.json:
        print(json.dumps(calls, indent=2))
        return
    print(f"MCP calls for {cell.get('name') or cell['id']} ({cell['id']}):")
    if not calls:
        print("  No calls found.")
        return
    for call in calls:
        print("  " + _format_mcp_call_line(call))


def cmd_doctor(args):
    report = get_doctor_local(args.port)
    if getattr(args, "mcp_health", False):
        if args.json:
            print(json.dumps(report.get("mcp_health", {}), indent=2))
        else:
            print(format_mcp_health_report(report))
        return
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(format_doctor_report(report))
    if report.get("result") != "pass":
        sys.exit(1)


def cmd_desktop(args):
    entrypoint = _resolve_desktop_entrypoint()
    if not entrypoint.is_file():
        die(f"Desktop entrypoint not found: {entrypoint}")

    profile = _resolve_desktop_profile(getattr(args, "profile", ""))
    port = _resolve_desktop_port(args)
    data_dir = _resolve_desktop_data_dir(profile, getattr(args, "data_dir", ""))
    python_path = _resolve_desktop_python(getattr(args, "python", ""))
    _ensure_desktop_runtime_ready(python_path)
    launch_mode = "attach" if getattr(args, "attach", False) else "spawn"

    env = os.environ.copy()
    env["TORQUE_STANDALONE"] = "1"
    env["TORQUE_DESKTOP_PROFILE"] = profile
    env["TORQUE_DESKTOP_PORT"] = str(port)
    env["TORQUE_DESKTOP_DATA_DIR"] = str(data_dir)
    env["TORQUE_PROFILE"] = profile
    env["TORQUE_PORT"] = str(port)
    env["TORQUE_DATA_DIR"] = str(data_dir)
    env["TORQUE_DESKTOP_MODE"] = launch_mode
    env["TORQUE_DESKTOP_ATTACH"] = "1" if launch_mode == "attach" else "0"

    print(f"Torque desktop {launch_mode}: http://127.0.0.1:{port}/")
    print(f"Profile: {profile}")
    print(f"Data dir: {data_dir}")
    print(f"Python: {python_path}")

    proc = subprocess.Popen([str(python_path), str(entrypoint)], env=env)
    try:
        returncode = proc.wait()
    except KeyboardInterrupt:
        try:
            proc.send_signal(signal.SIGINT)
            returncode = proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.terminate()
            returncode = proc.wait(timeout=5)
        sys.exit(130)

    if returncode:
        sys.exit(returncode)


