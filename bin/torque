def cmd_task_verify(args):
    """Record a deploy/restart verification checkpoint for a task."""
    st = get_state_local(args.port)
    t = resolve_task(st, args.identifier)

    payload = {
        "id": t["id"],
        "actor_name": "torque-cli",
    }
    if args.mode is not None:
        payload["verification_mode"] = "" if args.mode == "clear" else args.mode
    if args.state is not None:
        payload["verification_state"] = (
            "" if args.state == "clear" else args.state
        )
    if args.note is not None:
        payload["verification_notes"] = args.note
    if args.clear_note:
        payload["verification_notes"] = ""
    if args.tests is not None:
        payload["tests_run"] = args.tests
    if args.clear_tests:
        payload["tests_run"] = ""
    if args.human is not None:
        payload["human_validation_pending"] = args.human
    if args.clear_human:
        payload["human_validation_pending"] = ""
    if args.deploy_needed:
        payload["deploy_needed"] = True
    if args.clear_deploy_needed:
        payload["deploy_needed"] = False
    if args.attempted:
        payload["deploy_attempted"] = True
    if args.clear_attempted:
        payload["deploy_attempted"] = False
    if args.smoke is not None:
        if args.smoke == "clear":
            payload["manual_smoke_done"] = False
        else:
            payload["smoke_status"] = args.smoke

    if len(payload) == 2:
        die("No verification changes specified")

    resp = api_call("board_verify_task", port=args.port, **payload)
    data = check_ok(resp)
    print(data.get("message", "Verification updated"))


def cmd_workflow_breach(args):
    """Report a workflow-discipline breach as a coarse event."""
    st = get_state_local(args.port)
    task = resolve_task(st, args.task)
    payload = {
        "subkind": args.subkind,
        "task_id": task["id"],
        "context": args.context,
        "source": "operator",
    }
    resp = api_call("workflow_breach", port=args.port, **payload)
    data = check_ok(resp)
    event = data.get("event", {})
    subkind = event.get("subkind", args.subkind)
    print(f"Workflow breach recorded: {subkind} ({task['id']})")


def cmd_task_move(args):
    """Move a task to a different lane."""
    st = get_state_local(args.port)
    t = resolve_task(st, args.identifier)

    resp = api_call("board_move_task", port=args.port,
                    id=t["id"], lane=args.lane)
    check_ok(resp)
    print(f"Moved \"{t.get('task', '')}\" to {args.lane}")



