def _resolve_digest_agent(args):
    state_data = get_state(args.port)
    cell = resolve_cell(state_data, args.identifier)
    if cell.get("cell_type") != "agent":
        die(f"Digest target must be an agent: {args.identifier}")
    return cell


def _cmd_digest_pause_toggle(args, *, paused):
    cell = _resolve_digest_agent(args)
    cmd = "digest_pause" if paused else "digest_resume"
    resp = api_call(cmd, port=args.port, agent_id=cell["id"])
    check_ok(resp)
    state = "paused" if paused else "resumed"
    print(f"Digest {state} for \"{cell['name']}\"")


def cmd_digest_pause(args):
    _cmd_digest_pause_toggle(args, paused=True)


def cmd_digest_resume(args):
    _cmd_digest_pause_toggle(args, paused=False)


def cmd_memory_add(args):
    cell_id = os.environ.get("TORQUE_CELL_ID", "")
    kwargs = {
        "entry_type": args.type,
        "content": args.content,
        "pinned": bool(args.pin),
    }
    if getattr(args, "retention", ""):
        kwargs["retention_kind"] = args.retention
    if cell_id:
        kwargs["cell_id"] = cell_id
    if args.title:
        kwargs["title"] = args.title
    if args.scope:
        kwargs["scope_kind"] = args.scope
    if args.ref:
        kwargs["scope_ref"] = args.ref
    resp = api_call("memory_publish", port=args.port, **kwargs)
    data = check_ok(resp)
    entry = data.get("entry", {})
    print(f"Memory entry saved: {entry.get('id', '')}")


def cmd_memory_list(args):
    cell_id = os.environ.get("TORQUE_CELL_ID", "")
    kwargs = {
        "limit": args.limit,
        "offset": args.offset,
        "pinned_only": bool(args.pinned_only),
    }
    if cell_id:
        kwargs["cell_id"] = cell_id
    if args.scope:
        kwargs["scope_kind"] = args.scope
    if args.ref:
        kwargs["scope_ref"] = args.ref
    if args.type:
        kwargs["entry_type"] = args.type
    if args.search:
        kwargs["search"] = args.search
    if args.link_kind:
        kwargs["linked_target_kind"] = args.link_kind
    if args.link_ref:
        kwargs["linked_target_ref"] = args.link_ref
    resp = api_call("memory_list", port=args.port, **kwargs)
    data = check_ok(resp)
    entries = data.get("entries", [])
    if args.json:
        print(json.dumps(data, indent=2))
        return
    if not entries:
        print("No memory entries found.")
        return
    for entry in entries:
        star = "*" if entry.get("pinned") else " "
        scope = f"{entry.get('scope_kind', '')}:{entry.get('scope_ref', '')}"
        title = entry.get("title", "") or entry.get("content", "")[:60]
        print(f"{star} {entry.get('id', '')} [{entry.get('entry_type', '')}] {scope}")
        print(f"  {title}")
        if entry.get("retention_kind"):
            print(f"  retention: {entry['retention_kind']}")
        if entry.get("source_name"):
            print(f"  source: {entry['source_name']}")
        links = entry.get("links", [])
        if links:
            link_text = ", ".join(
                f"{link.get('target_kind', '')}:{link.get('target_ref', '')}"
                for link in links
            )
            print(f"  links: {link_text}")


def cmd_memory_show(args):
    resp = api_call("memory_read", port=args.port, entry_id=args.entry_id)
    data = check_ok(resp)
    entry = data.get("entry", {})
    if args.json:
        print(json.dumps(data, indent=2))
        return
    star = "*" if entry.get("pinned") else " "
    scope = f"{entry.get('scope_kind', '')}:{entry.get('scope_ref', '')}"
    print(f"{star} {entry.get('id', '')} [{entry.get('entry_type', '')}] {scope}")
    if entry.get("title"):
        print(f"title: {entry['title']}")
    print(f"content: {entry.get('content', '')}")
    if entry.get("retention_kind"):
        print(f"retention: {entry['retention_kind']}")
    if entry.get("source_name"):
        print(f"source: {entry['source_name']}")
    links = entry.get("links", [])
    if links:
        print("links:")
        for link in links:
            print(f"  - {link.get('target_kind', '')}:{link.get('target_ref', '')}")


