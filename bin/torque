def cmd_worktree_list(args):
    repo_root = resolve_repo_root(getattr(args, "repo", ""))
    resp = api_call("worktree_list", port=args.port, repo_root=repo_root)
    data = check_ok(resp)

    if args.json:
        print(json.dumps(data, indent=2))
        return

    items = data.get("items", [])
    print(f"Worktrees for {repo_root}")
    if not items:
        print("  No Torque-managed worktrees")
        return

    for item in items:
        branch = item.get("branch", "") or "(detached)"
        status = []
        if item.get("owner_agent_name"):
            status.append(f"owned by {item['owner_agent_name']}")
        if item.get("admin_stale"):
            status.append("admin-stale")
        elif item.get("dirty"):
            status.append("dirty")
        elif item.get("merged"):
            status.append("merged")
        else:
            status.append("unmerged")
        if item.get("prunable"):
            status.append("prunable")
        else:
            status.append(f"keep:{item.get('prune_reason', 'unknown')}")
        if item.get("base_branch"):
            status.append(f"base={item['base_branch']}")
        print(f"  {branch}")
        print(f"    {item.get('path', '')}")
        print(f"    {'; '.join(status)}")


def cmd_worktree_prune(args):
    repo_root = resolve_repo_root(getattr(args, "repo", ""))
    resp = api_call("worktree_prune", port=args.port, repo_root=repo_root)
    data = check_ok(resp)

    if args.json:
        print(json.dumps(data, indent=2))
        return

    removed = data.get("removed", [])
    skipped = data.get("skipped", [])
    print(f"Pruned worktrees for {repo_root}")
    if removed:
        print("  Removed:")
        for item in removed:
            branch = item.get("branch", "") or "(detached)"
            print(
                f"    {branch} — {item.get('path', '')} "
                f"({item.get('prune_reason', '')})"
            )
    else:
        print("  Removed: none")
    if skipped:
        print("  Skipped:")
        for item in skipped:
            branch = item.get("branch", "") or "(detached)"
            print(
                f"    {branch} — {item.get('path', '')} "
                f"({item.get('prune_reason', '')})"
            )


