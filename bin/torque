def build_parser():
    parser = argparse.ArgumentParser(
        prog="torque",
        description="Control the Torque daemon from the terminal",
    )
    parser.add_argument("--port", type=int, default=DEFAULT_PORT,
                        help=f"Daemon port (default: {DEFAULT_PORT})")
    parser.add_argument("--json", action="store_true",
                        help="Output raw JSON")
    sub = parser.add_subparsers(dest="command")

    # -- status -------------------------------------------------------------
    p = sub.add_parser("status", aliases=["st", "ls"],
                       help="Show groups and agents")
    p.add_argument("identifier", nargs="?",
                   help="Agent ID, slug, or name for detail view")
    p.add_argument("-g", "--group", help="Filter by group name")
    p.add_argument("-a", "--all", action="store_true",
                   help="Show all windows (default: current window only)")
    p.set_defaults(func=cmd_status)

    # -- doctor -------------------------------------------------------------
    p = sub.add_parser("doctor", help="Run Torque doctor checks")
    p.add_argument("--json", action="store_true",
                   help="Output raw JSON")
    p.add_argument("--mcp-health", action="store_true",
                   help="Show recent MCP retry/drop/dedupe/replay counts")
    p.set_defaults(func=cmd_doctor)

    # -- mcp-log ------------------------------------------------------------
    p = sub.add_parser("mcp-log", help="Dump recent MCP calls for an agent")
    p.add_argument("agent", help="Agent ID, slug, name, or ID prefix")
    p.add_argument("--limit", type=int, default=50,
                   help="Maximum calls to show")
    p.add_argument("--tool-filter", default="mcp__torque__%",
                   help="Exact tool name or LIKE/glob pattern")
    p.add_argument("--hook", default="PostToolUse",
                   help="Hook event filter (default: PostToolUse; empty for all)")
    p.add_argument("--since-seconds", type=int, default=0,
                   help="Only show calls newer than this many seconds")
    p.add_argument("--json", action="store_true",
                   help="Output JSON")
    p.set_defaults(func=cmd_mcp_log)

    # -- desktop ------------------------------------------------------------
    p = sub.add_parser("desktop", help="Launch Torque in the native desktop shell")
    p.add_argument("--attach", action="store_true",
                   help="Attach to an existing matching standalone Torque server "
                        "instead of spawning a desktop-owned child server")
    p.add_argument("--profile",
                   help=f"Standalone profile for the desktop app "
                        f"(default: {DESKTOP_DEFAULT_PROFILE})")
    p.add_argument("--port", dest="desktop_port", type=int,
                   help=f"Standalone port for the desktop app "
                        f"(default: {DESKTOP_DEFAULT_PORT})")
    p.add_argument("--data-dir",
                   help="Standalone data directory for the desktop app")
    p.add_argument("--python",
                   help="Python executable to use for the desktop shell")
    p.set_defaults(func=cmd_desktop)

    # -- daemon -------------------------------------------------------------
    dmn = sub.add_parser("daemon", help="Daemon lifecycle commands")
    dmn.set_defaults(func=None, _sub_parser=dmn)
    dmn_sub = dmn.add_subparsers(dest="daemon_cmd")

    p = dmn_sub.add_parser("status", help="Show daemon runtime status")
    p.add_argument("--port", dest="daemon_port", type=int,
                   help=f"Daemon port (default: {DESKTOP_DEFAULT_PORT}; "
                        "honors TORQUE_PORT)")
    p.set_defaults(func=cmd_daemon_status)

    p = dmn_sub.add_parser(
        "stop",
        help="Gracefully stop the daemon",
        description=(
            "Stop the Torque daemon via POST /api/cmd {cmd: 'stop'}, then "
            "wait for the listening port to close. Exit codes: 0 stopped, "
            "1 timeout, 2 connection/API error, 3 permission/system error."
        ),
    )
    p.add_argument("--port", dest="daemon_port", type=int,
                   help=f"Daemon port (default: {DESKTOP_DEFAULT_PORT}; "
                        "honors TORQUE_PORT)")
    p.add_argument("--timeout", type=float, default=10.0,
                   help="Seconds to wait for daemon drain/port close (default: 10)")
    p.add_argument("--force", action="store_true",
                   help="Skip API and send SIGTERM directly using lsof/PID file")
    p.set_defaults(func=cmd_daemon_stop)

    # -- group --------------------------------------------------------------
    grp = sub.add_parser("group", aliases=["g"],
                         help="Group management")
    grp.set_defaults(func=None, _sub_parser=grp)
    grp_sub = grp.add_subparsers(dest="group_cmd")

    p = grp_sub.add_parser("add", help="Create a group")
    p.add_argument("name", help="Group name")
    p.set_defaults(func=cmd_group_add)

    p = grp_sub.add_parser("remove", aliases=["rm"],
                           help="Remove a group")
    p.add_argument("name", help="Group name")
    p.set_defaults(func=cmd_group_remove)

    p = grp_sub.add_parser("rename", aliases=["mv"],
                           help="Rename a group")
    p.add_argument("old", help="Current name")
    p.add_argument("new", help="New name")
    p.set_defaults(func=cmd_group_rename)

    p = grp_sub.add_parser("settings", help="Show or update group settings")
    p.add_argument("name", help="Group name")
    p.add_argument("-s", "--set", nargs="+", metavar="KEY=VALUE",
                   help="Update settings (e.g., -s git_worktree=true)")
    p.set_defaults(func=cmd_group_settings)

    # -- agent --------------------------------------------------------------
    agt = sub.add_parser("agent", aliases=["a"],
                         help="Agent management")
    agt.set_defaults(func=None, _sub_parser=agt)
    agt_sub = agt.add_subparsers(dest="agent_cmd")

    p = agt_sub.add_parser("add", help="Create an agent")
    p.add_argument("name", help="Agent name")
    p.add_argument("-g", "--group",
                   help="Target group (auto-detected if in a Torque session)")
    p.add_argument("-c", "--command", help="Boot command")
    p.add_argument("-d", "--directory", help="Working directory")
    p.add_argument("--profile", help="iTerm2 profile")
    p.add_argument("--color", help="Tab color (hex, e.g., #f85149)")
    p.set_defaults(func=cmd_agent_add)

    p = agt_sub.add_parser("remove", aliases=["rm"],
                           help="Remove an agent")
    p.add_argument("identifier", help="Agent ID, slug, or name")
    p.set_defaults(func=cmd_agent_remove)

    p = agt_sub.add_parser("focus", help="Focus agent's iTerm2 session")
    p.add_argument("identifier", help="Agent ID, slug, or name")
    p.set_defaults(func=cmd_agent_focus)

