def cmd_ai_context(args):
    cell_id = os.environ.get("LOOM_CELL_ID", "")
    # Use local state (works offline)
    st = get_state_local(args.port)

    if cell_id:
        cell = st.get("agents", {}).get(cell_id)
    else:
        cell, _, _ = detect_context(st)

    if not cell:
        die("Cannot identify agent — not in a Loom-managed session")

    # Find linked tasks
    tasks = st.get("board_tasks", {})
    linked = [t for t in tasks.values()
              if t.get("agent_id") == cell["id"]]

    if args.json:
        print(json.dumps({"agent": cell, "tasks": linked}, indent=2))
        return

    # Human-readable summary
    slug = cell.get("slug", "") or cell["id"]
    print(f"Agent: {cell['name']} ({slug})")
    print(f"  Group:    {cell.get('group', '')}")
    print(f"  Status:   {cell.get('status', '')}")

    agent_type = cell.get("agent_type", "")
    if agent_type:
        print(f"  Type:     {agent_type}")

    directory = cell.get("directory", "")
    if directory:
        print(f"  Dir:      {directory}")

    wt_branch = cell.get("worktree_branch", "")
    if wt_branch:
        print(f"  Worktree: {cell.get('worktree_path', '')}"
              f"  ({wt_branch})")
        base = cell.get("worktree_base_branch", "")
        if base:
            print(f"  Base:     {base}")

    if not linked:
        print("\n  No linked tasks")
    else:
        for t in linked:
            tslug = t.get("slug", "") or t["id"][:6]
            print(f"\nTask: {t.get('task', '')}")
            print(f"  Slug:     {tslug}")
            print(f"  Lane:     {t.get('lane', '')}")
            if t.get("action_name"):
                print(f"  Action:   {t['action_name']}")
            if t.get("labels"):
                print(f"  Labels:   {', '.join(t['labels'])}")
            if t.get("external_url"):
                print(f"  PR:       {t['external_url']}")


def cmd_ai_derive(args):
    cell, task = _resolve_self_and_task(args)
    kwargs = {"cell_id": cell["id"], "action": "derive",
              "message": args.description}
    if getattr(args, "context", None):
        kwargs["description"] = args.context
    if task:
        kwargs["task_id"] = task["id"]
    if args.action:
        kwargs["action_name"] = args.action
    if args.var:
        tvars = {}
        for kv in args.var:
            k, _, v = kv.partition("=")
            if k:
                tvars[k] = v
        if tvars:
            kwargs["action_vars"] = tvars
    if args.group:
        kwargs["group"] = args.group
    resp = api_call("ai_report", port=args.port, **kwargs)
    data = check_ok(resp)
    new_tid = data.get("task_id", "")
    new_aid = data.get("agent_id", "")
    act = f" (action: {args.action})" if args.action else ""
    print(f"Derived task {new_tid}{act}")
    if new_aid:
        print(f"  Agent: {new_aid}")


def cmd_ai_ask(args):
    cell, task = _resolve_self_and_task(args)
    kwargs = {"cell_id": cell["id"], "action": "ask",
              "message": args.question}
    if getattr(args, "description", None):
        kwargs["description"] = args.description
    if task:
        kwargs["task_id"] = task["id"]
    resp = api_call("ai_report", port=args.port, **kwargs)
    data = check_ok(resp)
    new_tid = data.get("task_id", "")
    print(f"Ask task created in Backlog: {new_tid}")
    print("  A human will review and dispatch this task.")


def cmd_task_resolve(args):
    st = get_state_local(args.port)
    task = resolve_task(st, args.identifier)
    if "human" not in task.get("labels", []):
        _die("Not an ask task (missing 'human' label)")
    answer = args.answer
    if not answer:
        # Read from stdin or prompt
        import sys
        if not sys.stdin.isatty():
            answer = sys.stdin.read().strip()
        else:
            print(f"Question: {task.get('task', '')}")
            print("Enter your answer (Ctrl+D to finish):")
            try:
                answer = sys.stdin.read().strip()
            except EOFError:
                answer = ""
    if not answer:
        _die("Answer is required")
    resp = api_call("resolve_ask", port=args.port,
                    id=task["id"], answer=answer)
    check_ok(resp)
    print(f"Resolved: answer sent to parent agent.")


def cmd_task_chain(args):
    st = get_state_local(args.port)
    task = resolve_task(st, args.identifier)
    # Get chain via API if daemon is running, else walk locally
    root_id = task.get("pipeline_root_id") or task["id"]
    tasks = st.get("board_tasks", {})
    chain = [t for t in tasks.values()
             if (t.get("pipeline_root_id") == root_id)
             or (t["id"] == root_id)]
    chain.sort(key=lambda t: (t.get("pipeline_depth", 0),
                               t.get("created_at", "")))

    if not chain or (len(chain) == 1
                     and not chain[0].get("parent_task_id")):
        print("This task is not part of a pipeline.")
        return

    if args.json:
        print(json.dumps({"root_id": root_id, "chain": chain}, indent=2))
        return

    max_depth = max(t.get("pipeline_depth", 0) for t in chain)
    print(f"{_bold('Pipeline')}: {root_id} (depth {max_depth})\n")
    for t in chain:
        depth = t.get("pipeline_depth", 0)
        lane = t.get("lane", "")
        tid = t.get("slug") or t["id"][:8]
        task_text = t.get("task", "")[:50]
        agent = ""
        if t.get("agent_id"):
            agents = st.get("agents", {})
            a = agents.get(t["agent_id"])
            if a:
                agent = f"  {_dim(a.get('slug') or a.get('name', ''))}"

        if lane == "Done":
            icon = _green("✓")
        elif "error" in t.get("labels", []):
            icon = _red("✕")
        elif lane == "Backlog":
            icon = "○"
        else:
            icon = _yellow("→")

        status = t.get("status", "")
        status_str = f"  [{status}]" if status else ""
        indent = "  " * depth
        print(f"  {icon} {indent}[{depth}] {task_text:<40} "
              f"{_dim(lane)}{status_str}{agent}")


def cmd_pipeline_list(args):
    resp = api_call("discover_pipelines", port=args.port,
                    group=args.group or "")
    data = check_ok(resp)
    pipelines = data.get("pipelines", [])
    if not pipelines:
        print("No pipelines found (actions need 'transitions' field)")
        return

    if args.json:
        print(json.dumps(pipelines, indent=2))
        return

    print(f"{_bold('Pipelines')}\n")
    for p in pipelines:
        edge_strs = []
        for e in p.get("edges", []):
            edge_strs.append(f"{e['from']} → {e['to']}")
        summary = ", ".join(edge_strs) if edge_strs else "(no edges)"
        print(f"  {_bold(p['name']):<20} {_dim(summary)}")


def cmd_pipeline_show(args):
    resp = api_call("discover_pipelines", port=args.port,
                    group=args.group or "")
    data = check_ok(resp)
    pipelines = data.get("pipelines", [])
    match = [p for p in pipelines if p["name"] == args.name]
    if not match:
        die(f"Pipeline '{args.name}' not found")
    p = match[0]

    if args.json:
        print(json.dumps(p, indent=2))
        return

    print(f"{_bold('Pipeline')}: {p['name']} "
          f"({len(p.get('actions', []))} actions)\n")

    # Build adjacency for display
    adj = {}
    for e in p.get("edges", []):
        adj.setdefault(e["from"], []).append(e)

    for tname in sorted(p.get("actions", [])):
        edges = adj.get(tname, [])
        print(f"  {_bold(tname)}")
        for e in edges:
            when = f'  "{e["when"]}"' if e.get("when") else ""
            print(f"    → {e['to']}{_dim(when)}")
        if not edges:
            print(f"    {_dim('(terminal — no transitions)')}")
        print()


# ---------------------------------------------------------------------------
# Argument parser
# ---------------------------------------------------------------------------

def build_parser():
    parser = argparse.ArgumentParser(
        prog="loom",
        description="Control the Loom daemon from the terminal",
    )
    parser.add_argument("--port", type=int, default=DEFAULT_PORT,
                        help=f"Daemon port (default: {DEFAULT_PORT})")
    parser.add_argument("--json", action="store_true",
                        help="Output raw JSON")
    sub = parser.add_subparsers(dest="command")

    # -- status -------------------------------------------------------------
    p = sub.add_parser("status", aliases=["st", "ls"],
                       help="Show groups and agents")
    p.add_argument("identifier", nargs="?",
                   help="Agent ID, slug, or name for detail view")
    p.add_argument("-g", "--group", help="Filter by group name")
    p.add_argument("-a", "--all", action="store_true",
                   help="Show all windows (default: current window only)")
    p.set_defaults(func=cmd_status)

    # -- group --------------------------------------------------------------
    grp = sub.add_parser("group", aliases=["g"],
                         help="Group management")
    grp.set_defaults(func=None, _sub_parser=grp)
    grp_sub = grp.add_subparsers(dest="group_cmd")

    p = grp_sub.add_parser("add", help="Create a group")
    p.add_argument("name", help="Group name")
    p.set_defaults(func=cmd_group_add)

    p = grp_sub.add_parser("remove", aliases=["rm"],
                           help="Remove a group")
    p.add_argument("name", help="Group name")
    p.set_defaults(func=cmd_group_remove)

    p = grp_sub.add_parser("rename", aliases=["mv"],
                           help="Rename a group")
    p.add_argument("old", help="Current name")
    p.add_argument("new", help="New name")
    p.set_defaults(func=cmd_group_rename)

    p = grp_sub.add_parser("settings", help="Show or update group settings")
    p.add_argument("name", help="Group name")
    p.add_argument("-s", "--set", nargs="+", metavar="KEY=VALUE",
                   help="Update settings (e.g., -s git_worktree=true)")
    p.set_defaults(func=cmd_group_settings)

    # -- agent --------------------------------------------------------------
    agt = sub.add_parser("agent", aliases=["a"],
                         help="Agent management")
    agt.set_defaults(func=None, _sub_parser=agt)
    agt_sub = agt.add_subparsers(dest="agent_cmd")

    p = agt_sub.add_parser("add", help="Create an agent")
    p.add_argument("name", help="Agent name")
    p.add_argument("-g", "--group",
                   help="Target group (auto-detected if in a Loom session)")
    p.add_argument("-c", "--command", help="Boot command")
    p.add_argument("-d", "--directory", help="Working directory")
    p.add_argument("--profile", help="iTerm2 profile")
    p.add_argument("--color", help="Tab color (hex, e.g., #f85149)")
    p.set_defaults(func=cmd_agent_add)

    p = agt_sub.add_parser("remove", aliases=["rm"],
                           help="Remove an agent")
    p.add_argument("identifier", help="Agent ID, slug, or name")
    p.set_defaults(func=cmd_agent_remove)

    p = agt_sub.add_parser("focus", help="Focus agent's iTerm2 session")
    p.add_argument("identifier", help="Agent ID, slug, or name")
    p.set_defaults(func=cmd_agent_focus)

    p = agt_sub.add_parser("relaunch", help="Restart a stopped agent")
    p.add_argument("identifier", help="Agent ID, slug, or name")
    p.set_defaults(func=cmd_agent_relaunch)

    p = agt_sub.add_parser("move", help="Move agent to different group")
    p.add_argument("identifier", help="Agent ID, slug, or name")
    p.add_argument("-g", "--group", required=True, help="Target group")
    p.set_defaults(func=cmd_agent_move)

    p = agt_sub.add_parser("edit", help="Update agent name or color")
    p.add_argument("identifier", help="Agent ID, slug, or name")
    p.add_argument("--name", help="New name")
    p.add_argument("--color", help="New tab color (hex)")
    p.set_defaults(func=cmd_agent_edit)

    # -- terminal -----------------------------------------------------------
    trm = sub.add_parser("terminal", aliases=["t", "term"],
                         help="Terminal management")
    trm.set_defaults(func=None, _sub_parser=trm)
    trm_sub = trm.add_subparsers(dest="terminal_cmd")

    p = trm_sub.add_parser("add", help="Create a terminal")
    p.add_argument("name", help="Terminal name")
    p.add_argument("-p", "--parent", help="Parent agent ID, slug, or name")
    p.add_argument("-g", "--group", help="Group (if no parent)")
    p.add_argument("-c", "--command", help="Boot command")
    p.add_argument("-d", "--directory", help="Working directory")
    p.add_argument("--profile", help="iTerm2 profile")
    p.add_argument("--color", help="Tab color (hex)")
    p.set_defaults(func=cmd_terminal_add)

    p = trm_sub.add_parser("remove", aliases=["rm"],
                           help="Remove a terminal")
    p.add_argument("identifier", help="Terminal ID, slug, or name")
    p.set_defaults(func=cmd_terminal_remove)

    p = trm_sub.add_parser("reparent", help="Reparent a terminal")
    p.add_argument("identifier", help="Terminal ID, slug, or name")
    p.add_argument("-p", "--parent", help="New parent agent ID, slug, or name")
    p.add_argument("--detach", action="store_true",
                   help="Detach from parent")
    p.set_defaults(func=cmd_terminal_reparent)

    # -- send ---------------------------------------------------------------
    p = sub.add_parser("send", help="Send text to a session")
    p.add_argument("text", help="Text to send")
    p.add_argument("-t", "--to",  dest="identifier", default="",
                   help="Target agent/terminal ID, slug, or name "
                        "(auto-detected if in a Loom session)")
    p.add_argument("-w", "--wait", action="store_true",
                   help="Wait until the agent finishes (polls every 2s)")
    p.set_defaults(func=cmd_send)

    # -- broadcast ----------------------------------------------------------
    p = sub.add_parser("broadcast", aliases=["bc"],
                       help="Broadcast text to a group")
    p.add_argument("group", help="Group name")
    p.add_argument("text", help="Text to broadcast")
    p.set_defaults(func=cmd_broadcast)

    # -- worktree -----------------------------------------------------------
    wt = sub.add_parser("worktree", aliases=["wt"],
                        help="Git worktree management")
    wt.set_defaults(func=None, _sub_parser=wt)
    wt_sub = wt.add_subparsers(dest="worktree_cmd")

    p = wt_sub.add_parser("create", help="Create worktree for agent")
    p.add_argument("identifier", help="Agent ID, slug, or name")
    p.add_argument("--relaunch", action="store_true",
                   help="Relaunch agent in worktree")
    p.set_defaults(func=cmd_worktree_create)

    p = wt_sub.add_parser("remove", aliases=["rm"],
                           help="Remove worktree")
    p.add_argument("identifier", help="Agent ID, slug, or name")
    p.add_argument("--relaunch", action="store_true",
                   help="Relaunch agent after removal")
    p.set_defaults(func=cmd_worktree_remove)

    p = wt_sub.add_parser("checkpoint", aliases=["cp"],
                           help="Create checkpoint commit")
    p.add_argument("identifier", help="Agent ID, slug, or name")
    p.set_defaults(func=cmd_worktree_checkpoint)

    p = wt_sub.add_parser("history", aliases=["log"],
                           help="Show checkpoint history")
    p.add_argument("identifier", help="Agent ID, slug, or name")
    p.set_defaults(func=cmd_worktree_history)

    p = wt_sub.add_parser("rollback", help="Rollback to checkpoint")
    p.add_argument("identifier", help="Agent ID, slug, or name")
    p.add_argument("sha", help="Commit SHA to rollback to")
    p.set_defaults(func=cmd_worktree_rollback)

    # -- task ---------------------------------------------------------------
    tsk = sub.add_parser("task", help="Task/ticket management")
    tsk.set_defaults(func=None, _sub_parser=tsk)
    tsk_sub = tsk.add_subparsers(dest="task_cmd")

    p = tsk_sub.add_parser("create", aliases=["c"],
                           help="Create a ticket in the Backlog")
    p.add_argument("description", help="Task title")
    p.add_argument("-d", "--context", help="Longer description / context")
    p.add_argument("-g", "--group",
                   help="Target group (auto-detected if in a Loom session)")
    p.add_argument("-t", "--action", help="Action name to attach")
    p.add_argument("-v", "--var", nargs="+", metavar="KEY=VALUE",
                   help="Action variables (e.g., -v CONTEXT='some info')")
    p.add_argument("-l", "--labels", help="Comma-separated labels")
    p.set_defaults(func=cmd_task_create)

    p = tsk_sub.add_parser("dispatch", aliases=["d"],
                           help="Create ticket, launch agent, and send task")
    p.add_argument("description", help="Task description (sent to agent)")
    p.add_argument("-t", "--action", help="Action name")
    p.add_argument("-g", "--group",
                   help="Target group (auto-detected if in a Loom session)")
    p.add_argument("-n", "--name", help="Agent name override")
    p.add_argument("-c", "--command", help="Boot command override")
    p.add_argument("-d", "--directory", help="Working directory override")
    p.add_argument("-v", "--var", nargs="+", metavar="KEY=VALUE",
                   help="Action variables (e.g., -v TEST_COMMAND='pytest')")
    p.add_argument("-l", "--labels", help="Comma-separated labels")
    p.add_argument("-w", "--wait", action="store_true",
                   help="Wait for the agent to finish")
    p.add_argument("--no-task", action="store_true",
                   help="Create agent but don't send the task text")
    p.set_defaults(func=cmd_task_dispatch)

    p = tsk_sub.add_parser("show", help="Show full task details")
    p.add_argument("identifier", help="Task ID, slug, or title")
    p.set_defaults(func=cmd_task_show)

    p = tsk_sub.add_parser("list", aliases=["ls"],
                           help="List tasks (with optional filters)")
    p.add_argument("-l", "--lane", help="Filter by lane name")
    p.add_argument("-g", "--group", help="Filter by group name")
    p.add_argument("--label", help="Filter by label")
    p.set_defaults(func=cmd_task_list)

    p = tsk_sub.add_parser("edit", aliases=["e"],
                           help="Edit task fields")
    p.add_argument("identifier", help="Task ID, slug, or title")
    p.add_argument("-t", "--task", help="New task description")
    p.add_argument("--action", help="Set or change action")
    p.add_argument("-v", "--var", nargs="+", metavar="KEY=VALUE",
                   help="Set action variables")
    p.add_argument("-l", "--labels", help="Comma-separated labels")
    p.add_argument("-g", "--group", help="Move to different group")
    p.set_defaults(func=cmd_task_edit)

    p = tsk_sub.add_parser("move", aliases=["mv"],
                           help="Move task to a different lane")
    p.add_argument("identifier", help="Task ID, slug, or title")
    p.add_argument("-l", "--lane", required=True, help="Target lane")
    p.set_defaults(func=cmd_task_move)

    p = tsk_sub.add_parser("chain", help="Show pipeline derivation chain")
    p.add_argument("identifier", help="Task ID, slug, or title")
    p.set_defaults(func=cmd_task_chain)

    p = tsk_sub.add_parser("resolve", help="Resolve an ask task with an answer")
    p.add_argument("identifier", help="Task ID, slug, or title")
    p.add_argument("answer", nargs="?", help="Answer text")
    p.set_defaults(func=cmd_task_resolve)

    # -- action -------------------------------------------------------------
    act = sub.add_parser("action", aliases=["act"],
                         help="Action management")
    act.set_defaults(func=None, _sub_parser=act)
    act_sub = act.add_subparsers(dest="action_cmd")

    p = act_sub.add_parser("list", aliases=["ls"],
                           help="List available actions")
    p.set_defaults(func=cmd_action_list)

    p = act_sub.add_parser("show", help="Show action contents")
    p.add_argument("name", help="Action name")
    p.set_defaults(func=cmd_action_show)

    p = act_sub.add_parser("create", help="Create a starter action")
    p.add_argument("name", help="Action name")
    p.set_defaults(func=cmd_action_create)

    # -- board --------------------------------------------------------------
    brd = sub.add_parser("board", aliases=["bd"],
                         help="Task board management")
    brd.set_defaults(func=cmd_board_list, _sub_parser=brd)
    brd_sub = brd.add_subparsers(dest="board_cmd")

    p = brd_sub.add_parser("list", aliases=["ls"],
                            help="List tasks by lane")
    p.add_argument("-l", "--lane", help="Filter by lane name")
    p.set_defaults(func=cmd_board_list)

    p = brd_sub.add_parser("add", help="Add a task")
    p.add_argument("task", help="Task description")
    p.add_argument("-g", "--group",
                   help="Target group (auto-detected if in a Loom session)")
    p.add_argument("-l", "--lane", help="Target lane (default: first lane)")
    p.set_defaults(func=cmd_board_add)

    p = brd_sub.add_parser("move", help="Move a task to a lane")
    p.add_argument("identifier", help="Task ID, slug, or title")
    p.add_argument("-l", "--lane", required=True,
                   help="Target lane")
    p.set_defaults(func=cmd_board_move)

    p = brd_sub.add_parser("remove", aliases=["rm"],
                            help="Remove a task")
    p.add_argument("identifier", help="Task ID, slug, or title")
    p.set_defaults(func=cmd_board_remove)

    p = brd_sub.add_parser("lanes", help="List lanes")
    p.set_defaults(func=cmd_board_lanes)

    # -- ai (agent reporting) -----------------------------------------------
    ai = sub.add_parser("ai", help="Agent reporting (used by AI agents)")
    ai.set_defaults(func=None, _sub_parser=ai)
    ai_sub = ai.add_subparsers(dest="ai_cmd")

    p = ai_sub.add_parser("done", help="Mark task as done")
    p.add_argument("-m", "--message", help="Completion summary")
    p.add_argument("task_ref", nargs="?",
                   help="Task slug/ID (auto-detected)")
    p.set_defaults(func=cmd_ai_done)

    p = ai_sub.add_parser("blocked", help="Signal blocked on user input")
    p.add_argument("reason", help="Why the agent is blocked")
    p.add_argument("task_ref", nargs="?",
                   help="Task slug/ID (auto-detected)")
    p.set_defaults(func=cmd_ai_blocked)

    p = ai_sub.add_parser("error", help="Report an unrecoverable error")
    p.add_argument("message", help="Error description")
    p.add_argument("task_ref", nargs="?",
                   help="Task slug/ID (auto-detected)")
    p.set_defaults(func=cmd_ai_error)

    p = ai_sub.add_parser("progress", help="Report current progress")
    p.add_argument("message", help="Progress description")
    p.add_argument("task_ref", nargs="?",
                   help="Task slug/ID (auto-detected)")
    p.set_defaults(func=cmd_ai_progress)

    p = ai_sub.add_parser("ready", help="Signal ready for next task")
    p.add_argument("task_ref", nargs="?",
                   help="Task slug/ID (auto-detected)")
    p.set_defaults(func=cmd_ai_ready)

    p = ai_sub.add_parser("name",
                           help="Rename agent based on task objective")
    p.add_argument("name", help="Short descriptive name (kebab-case)")
    p.set_defaults(func=cmd_ai_name)

    p = ai_sub.add_parser("context", help="Show current agent context")
    p.set_defaults(func=cmd_ai_context)

    p = ai_sub.add_parser("derive",
                          help="Derive a new task and dispatch next agent")
    p.add_argument("description", help="Short task title for the next step")
    p.add_argument("-d", "--context", help="Longer description / details")
    p.add_argument("-t", "--action", help="Action for the new task")
    p.add_argument("-v", "--var", nargs="+", metavar="KEY=VALUE",
                   help="Action variables")
    p.add_argument("-g", "--group", help="Target group (inherit from task)")
    p.add_argument("task_ref", nargs="?",
                   help="Task slug/ID (auto-detected)")
    p.set_defaults(func=cmd_ai_derive)

    p = ai_sub.add_parser("ask",
                          help="Create a task for human decision")
    p.add_argument("question", help="Question for the human to review")
    p.add_argument("-d", "--description",
                   help="Longer description (question becomes the title)")
    p.add_argument("task_ref", nargs="?",
                   help="Task slug/ID (auto-detected)")
    p.set_defaults(func=cmd_ai_ask)

    # -- task chain ---------------------------------------------------------
    # (added to task subcommand group)

    # -- pipeline -----------------------------------------------------------
    pipe = sub.add_parser("pipeline", aliases=["pl"],
                          help="Pipeline discovery and visualization")
    pipe.set_defaults(func=cmd_pipeline_list, _sub_parser=pipe)
    pipe_sub = pipe.add_subparsers(dest="pipeline_cmd")

    p = pipe_sub.add_parser("list", aliases=["ls"],
                            help="List discovered pipelines")
    p.add_argument("-g", "--group", help="Scope to group")
    p.set_defaults(func=cmd_pipeline_list)

    p = pipe_sub.add_parser("show", help="Show pipeline details")
    p.add_argument("name", help="Pipeline name")
    p.add_argument("-g", "--group", help="Scope to group")
    p.set_defaults(func=cmd_pipeline_show)

    # -- logs ---------------------------------------------------------------
    p = sub.add_parser("logs", help="Tail daemon log")
    p.add_argument("-f", "--follow", action="store_true",
                   help="Follow log output")
    p.set_defaults(func=cmd_logs)

    return parser


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = build_parser()
    args = parser.parse_args()

    if not hasattr(args, "func") or args.func is None:
        # Show help for the subcommand (e.g. "loom agent") or top-level
        sub_parser = getattr(args, "_sub_parser", None)
        (sub_parser or parser).print_help()
        sys.exit(1)

    args.func(args)


if __name__ == "__main__":
    main()
