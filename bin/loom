def cmd_logs(args):
    if not os.path.isfile(LOOM_LOG):
        die(f"Log file not found: {LOOM_LOG}")
    if args.follow:
        os.execvp("tail", ["tail", "-f", LOOM_LOG])
    else:
        os.execvp("tail", ["tail", "-50", LOOM_LOG])


