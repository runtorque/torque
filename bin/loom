def cmd_terminal_add(args):
    kwargs = {
        "name": args.name,
        "parent_id": "",
    }
    if args.parent:
        state_data = get_state(args.port)
        parent = resolve_cell(state_data, args.parent)
        kwargs["parent_id"] = parent["id"]
        kwargs["group"] = parent.get("group", "")
    elif args.group:
        kwargs["group"] = args.group
    else:
        # Auto-detect from current iTerm2 session
        state_data = get_state(args.port)
        _cell, parent, group = detect_context(state_data)
        if parent:
            kwargs["parent_id"] = parent["id"]
            kwargs["group"] = parent.get("group", "")
        elif group:
            kwargs["group"] = group
        else:
            die("Either --parent (-p) or --group (-g) is required\n"
                "  (auto-detect failed — not in a Loom-managed session)")

    if args.command:
        kwargs["command"] = args.command
    if args.directory:
        kwargs["directory"] = args.directory
    if args.profile:
        kwargs["profile"] = args.profile
    if args.color:
        kwargs["tab_color"] = args.color

    resp = api_call("add_terminal", port=args.port, **kwargs)
    data = check_ok(resp)

    agents = data.get("agents", {})
    match = [c for c in agents.values()
             if c["name"] == args.name and c.get("cell_type") == "terminal"]
    if match:
        cell = match[-1]
        slug = cell.get("slug", "")
        print(f"Terminal \"{args.name}\" created (id: {cell['id']}, slug: {slug})")
    else:
        print(f"Terminal \"{args.name}\" created")


