    cell = resolve_cell(state_data, args.identifier)
    kwargs = {"id": cell["id"]}
    if args.relaunch:
        kwargs["relaunch"] = True
    resp = api_call("worktree_remove", port=args.port, **kwargs)
    check_ok(resp)
    print(f"Worktree removed for \"{cell['name']}\"")


def cmd_worktree_checkpoint(args):
    state_data = get_state(args.port)
    cell = resolve_cell(state_data, args.identifier)
    resp = api_call("worktree_checkpoint", port=args.port, id=cell["id"])
    check_ok(resp)
    print(f"Checkpoint created for \"{cell['name']}\"")


def cmd_worktree_history(args):
    state_data = get_state(args.port)
    cell = resolve_cell(state_data, args.identifier)
    resp = api_call("worktree_history", port=args.port, id=cell["id"])
    data = check_ok(resp)

    if args.json:
        print(json.dumps(data, indent=2))
        return

    branch = data.get("branch", "")
    base = data.get("base_branch", "")
    commits = data.get("commits", [])

    print(f"Worktree history for \"{cell['name']}\"")
    if branch:
        print(f"  Branch: {branch} (base: {base})")
    if not commits:
        print("  No checkpoints")
        return

    print(f"\n  {'SHA':<10} {'Date':<20} {'Subject'}")
    print(f"  {'─' * 10} {'─' * 20} {'─' * 40}")
    for c in commits:
        sha = c.get("sha", "")[:8]
        ts = c.get("timestamp", "")
        subj = c.get("subject", "")
        print(f"  {sha:<10} {ts:<20} {subj}")


def cmd_worktree_rollback(args):
    state_data = get_state(args.port)
    cell = resolve_cell(state_data, args.identifier)
    resp = api_call("worktree_rollback", port=args.port,
                    id=cell["id"], sha=args.sha)
    check_ok(resp)
    print(f"Rolled back \"{cell['name']}\" to {args.sha[:8]}")


# -- Dispatch ---------------------------------------------------------------

def cmd_dispatch(args):
    state_data = get_state(args.port)

    # Resolve group
    group = args.group
    if not group:
        _cell, _parent, group = detect_context(state_data)
        if not group:
            die("--group (-g) is required\n"
                "  (auto-detect failed — not in a Loom-managed session)")

    # Build variables dict
    variables = {"TASK": args.description}
    if args.var:
        for kv in args.var:
            if "=" not in kv:
                die(f"Invalid variable format: {kv} (expected KEY=VALUE)")
            k, v = kv.split("=", 1)
            variables[k] = v

    if args.template:
        # Server-side rendering via add_agent_from_template
        # Resolve agent name client-side for display
        tpl = load_template(args.template)
        tpl_agent = tpl.get("agent", {}) if tpl else {}
        if args.name:
            agent_name = args.name
        elif tpl_agent.get("name_prefix"):
            slug = task_slug(args.description)
            agent_name = f"{tpl_agent['name_prefix']}-{slug}"
        else:
            slug = task_slug(args.description)
            agent_name = slug or "agent"

        kwargs = {
            "group": group,
            "template": args.template,
            "vars": variables,
            "name": agent_name,
        }
        if args.command:
            kwargs["command"] = args.command
        if args.directory:
            kwargs["directory"] = args.directory

        if args.no_prompt:
            # Remove TASK so no prompt is sent
            variables.pop("TASK", None)
            kwargs["vars"] = variables

        resp = api_call("add_agent_from_template", port=args.port, **kwargs)
    else:
        # No template — plain add_agent + send_text
        slug = task_slug(args.description)
        agent_name = args.name or slug or "agent"
        kwargs = {"name": agent_name, "group": group}
        if args.command:
            kwargs["command"] = args.command
        if args.directory:
            kwargs["directory"] = args.directory
        resp = api_call("add_agent", port=args.port, **kwargs)

    data = check_ok(resp)

    # Find the new agent in the returned state
    agents = data.get("agents", {})
    match = [c for c in agents.values()
             if c["name"] == agent_name and c["group"] == group]
    if not match:
        die("Agent creation succeeded but could not find it in state")
    cell = match[-1]
    cell_id = cell["id"]
    print(f"Agent \"{agent_name}\" created (id: {cell_id})")

    # For non-template dispatch, send prompt manually
    if not args.template and not args.no_prompt:
        booted = wait_for_boot(cell_id, args.port)
        if not booted:
            die("Agent failed to boot within 15 seconds")
        time.sleep(1.5)
        prompt = args.description
        if not prompt.endswith("\r") and not prompt.endswith("\n"):
            prompt += "\r"
        resp = api_call("send_text", port=args.port, id=cell_id, text=prompt)
        check_ok(resp)
        print(f"Prompt sent to \"{agent_name}\"")

    if args.wait:
        # For template dispatch, prompt is sent server-side after boot delay
        # Give it a moment to start
        if args.template:
            time.sleep(3)
        rc = wait_for_idle(cell_id, agent_name, args.port)
        sys.exit(rc)


# -- Template ---------------------------------------------------------------

def cmd_template_list(args):
    templates = list_templates()
    if not templates:
        dirs = find_templates_dirs()
        if dirs:
            print(f"No templates found in {dirs[0]}")
        else:
            print("No template directories found")
            print("  Project: .loom/templates/  (in repo root)")
            print("  Global:  ~/.loom/templates/")
        return

    if args.json:
        print(json.dumps(templates, indent=2))
        return

    dirs = find_templates_dirs()
    print(f"{_bold('Templates')}  {_dim(', '.join(dirs))}\n")
    for t in templates:
        tag = _dim(" (global)") if t.get("global") else ""
        print(f"  {t['name']:<20} {_dim(t['description'])}{tag}")


def cmd_template_show(args):
    tpl = load_template(args.name)
    if args.json:
        print(json.dumps(tpl, indent=2))
        return

    _print_dict(tpl)

    # Auto-discover variables via regex (CLI has no Jinja2)
    import re
    tdir = find_templates_dir()
    raw = ""
    if tdir:
        for suffix in ("", ".yaml", ".yml"):
            path = os.path.join(tdir, args.name + suffix)
            if os.path.isfile(path):
                with open(path) as f:
                    raw = f.read()
                break
    # Find {{ VAR }} and {{ VAR | default('val') }}
    var_pattern = re.compile(
        r'\{\{\s*(\w+)\s*(?:\|\s*default\s*\(\s*[\'"]([^"\']*)[\'"]'
        r'\s*\))?\s*\}\}')
    seen = {}
    for m in var_pattern.finditer(raw):
        vname, default = m.group(1), m.group(2)
        if vname not in seen:
            seen[vname] = default or ""

    if seen:
        ordered = sorted(k for k in seen if k != "TASK")
        if "TASK" in seen:
            ordered = ["TASK"] + ordered
        print(f"\n{_bold('Variables:')}")
        for vname in ordered:
            default = seen[vname]
            tag = _red(" (required)") if vname == "TASK" else ""
            line = f"  {_bold(vname)}{tag}"
            if default:
                line += f"  {_dim(f'default: {default}')}"
            print(line)


def _print_dict(d, indent=0):
    """Pretty-print a dict with indentation."""
    prefix = "  " * indent
    for k, v in d.items():
        if isinstance(v, dict):
            print(f"{prefix}{_bold(k)}:")
            _print_dict(v, indent + 1)
        elif isinstance(v, list):
            print(f"{prefix}{_bold(k)}:")
            for item in v:
                if isinstance(item, dict):
                    first = True
                    for ik, iv in item.items():
                        marker = "- " if first else "  "
                        print(f"{prefix}  {marker}{ik}: {iv}")
                        first = False
                else:
                    print(f"{prefix}  - {item}")
        elif isinstance(v, str) and "\n" in v:
            print(f"{prefix}{_bold(k)}: |")
            for line in v.split("\n"):
                print(f"{prefix}  {line}")
        else:
            print(f"{prefix}{_bold(k)}: {v}")


def cmd_template_create(args):
    tdir = find_templates_dir()
    if not tdir:
        # Create .loom/templates/ in the repo root (or cwd)
        root = os.getcwd()
        tdir = os.path.join(root, ".loom", "templates")
        os.makedirs(tdir, exist_ok=True)
        print(f"Created {tdir}")

    path = os.path.join(tdir, f"{args.name}.yaml")
    if os.path.exists(path):
        die(f"Template \"{args.name}\" already exists at {path}")

    starter = f"""name: {args.name}
description: ""

agent:
  name_prefix: {args.name}
  # command: claude
  # tab_color: "#f85149"

# worktree: true

prompt: |
  ${{TASK}}
"""
    with open(path, "w") as f:
        f.write(starter)
    print(f"Created {path}")
    print(f"  Edit it, then run: loom dispatch \"your task\" --template {args.name}")


# -- Logs -------------------------------------------------------------------

def cmd_logs(args):
    if not os.path.isfile(LOOM_LOG):
        die(f"Log file not found: {LOOM_LOG}")
    if args.follow:
        os.execvp("tail", ["tail", "-f", LOOM_LOG])
    else:
        os.execvp("tail", ["tail", "-50", LOOM_LOG])


# ---------------------------------------------------------------------------
# Board commands
# ---------------------------------------------------------------------------

def cmd_board_list(args):
    st = get_state(args.port)
    lanes = st.get("board_lanes", [])
    tasks = st.get("board_tasks", {})
    lane_filter = args.lane if hasattr(args, "lane") and args.lane else None

    if args.json:
        import json as _j
        print(_j.dumps({"lanes": lanes, "tasks": tasks}, indent=2))
        return

    for lane in lanes:
        if lane_filter and lane.lower() != lane_filter.lower():
            continue
        lane_tasks = sorted(
            [t for t in tasks.values() if t["lane"] == lane],
            key=lambda t: t.get("position", 0),
        )
        print(f"\n  {_bold(lane)} ({len(lane_tasks)})")
        if not lane_tasks:
            print(f"    {_dim('(empty)')}")
        for t in lane_tasks:
            agent_str = ""
            if t.get("agent_id"):
                a = st.get("agents", {}).get(t["agent_id"])
                if a:
                    agent_str = f" {_cyan('→ ' + a['name'])}"
            tid = _dim(t["id"][:6])
            print(f"    {tid}  {t['title']}{agent_str}")
    print()


def cmd_board_add(args):
    resp = api_call("board_add_task", port=args.port,
                    title=args.title, lane=args.lane or "")
    data = check_ok(resp)
    if args.json:
        import json as _j
        print(_j.dumps(data, indent=2))
    else:
        print(f"Task added to {args.lane or 'first lane'}")


def cmd_board_move(args):
    st = get_state(args.port)
    tasks = st.get("board_tasks", {})

    # Resolve task by ID prefix or title match
    match = None
    identifier = args.identifier
    for tid, t in tasks.items():
        if tid.startswith(identifier) or t["title"].lower() == identifier.lower():
            match = t
            break
    if not match:
        die(f"Task not found: {identifier}")

    resp = api_call("board_move_task", port=args.port,
                    id=match["id"], lane=args.lane)
    check_ok(resp)
    print(f"Moved \"{match['title']}\" to {args.lane}")


def cmd_board_remove(args):
    st = get_state(args.port)
    tasks = st.get("board_tasks", {})

    match = None
    identifier = args.identifier
    for tid, t in tasks.items():
        if tid.startswith(identifier) or t["title"].lower() == identifier.lower():
            match = t
            break
    if not match:
        die(f"Task not found: {identifier}")

    resp = api_call("board_remove_task", port=args.port, id=match["id"])
    check_ok(resp)
    print(f"Removed \"{match['title']}\"")


def cmd_board_lanes(args):
    st = get_state(args.port)
    lanes = st.get("board_lanes", [])
    tasks = st.get("board_tasks", {})

    if args.json:
        import json as _j
        print(_j.dumps(lanes, indent=2))
        return

    for lane in lanes:
        cnt = sum(1 for t in tasks.values() if t["lane"] == lane)
        print(f"  {lane} ({cnt})")


# ---------------------------------------------------------------------------
# Argument parser
# ---------------------------------------------------------------------------

def build_parser():
    parser = argparse.ArgumentParser(
        prog="loom",
        description="Control the Loom daemon from the terminal",
    )
    parser.add_argument("--port", type=int, default=DEFAULT_PORT,
                        help=f"Daemon port (default: {DEFAULT_PORT})")
    parser.add_argument("--json", action="store_true",
                        help="Output raw JSON")
    sub = parser.add_subparsers(dest="command")

    # -- status -------------------------------------------------------------
    p = sub.add_parser("status", aliases=["st", "ls"],
                       help="Show groups and agents")
    p.add_argument("identifier", nargs="?",
                   help="Agent ID or name for detail view")
    p.add_argument("-g", "--group", help="Filter by group name")
    p.add_argument("-a", "--all", action="store_true",
                   help="Show all windows (default: current window only)")
    p.set_defaults(func=cmd_status)

    # -- group --------------------------------------------------------------
    grp = sub.add_parser("group", aliases=["g"],
                         help="Group management")
    grp.set_defaults(func=None, _sub_parser=grp)
    grp_sub = grp.add_subparsers(dest="group_cmd")

    p = grp_sub.add_parser("add", help="Create a group")
    p.add_argument("name", help="Group name")
    p.set_defaults(func=cmd_group_add)

    p = grp_sub.add_parser("remove", aliases=["rm"],
                           help="Remove a group")
    p.add_argument("name", help="Group name")
    p.set_defaults(func=cmd_group_remove)

    p = grp_sub.add_parser("rename", aliases=["mv"],
                           help="Rename a group")
    p.add_argument("old", help="Current name")
    p.add_argument("new", help="New name")
    p.set_defaults(func=cmd_group_rename)

    p = grp_sub.add_parser("settings", help="Show or update group settings")
    p.add_argument("name", help="Group name")
    p.add_argument("-s", "--set", nargs="+", metavar="KEY=VALUE",
                   help="Update settings (e.g., -s git_worktree=true)")
    p.set_defaults(func=cmd_group_settings)

    # -- agent --------------------------------------------------------------
    agt = sub.add_parser("agent", aliases=["a"],
                         help="Agent management")
    agt.set_defaults(func=None, _sub_parser=agt)
    agt_sub = agt.add_subparsers(dest="agent_cmd")

    p = agt_sub.add_parser("add", help="Create an agent")
    p.add_argument("name", help="Agent name")
    p.add_argument("-g", "--group",
                   help="Target group (auto-detected if in a Loom session)")
    p.add_argument("-c", "--command", help="Boot command")
    p.add_argument("-d", "--directory", help="Working directory")
    p.add_argument("--profile", help="iTerm2 profile")
    p.add_argument("--color", help="Tab color (hex, e.g., #f85149)")
    p.set_defaults(func=cmd_agent_add)

    p = agt_sub.add_parser("remove", aliases=["rm"],
                           help="Remove an agent")
    p.add_argument("identifier", help="Agent ID or name")
    p.set_defaults(func=cmd_agent_remove)

    p = agt_sub.add_parser("focus", help="Focus agent's iTerm2 session")
    p.add_argument("identifier", help="Agent ID or name")
    p.set_defaults(func=cmd_agent_focus)

    p = agt_sub.add_parser("relaunch", help="Restart a stopped agent")
    p.add_argument("identifier", help="Agent ID or name")
    p.set_defaults(func=cmd_agent_relaunch)

    p = agt_sub.add_parser("move", help="Move agent to different group")
    p.add_argument("identifier", help="Agent ID or name")
    p.add_argument("-g", "--group", required=True, help="Target group")
    p.set_defaults(func=cmd_agent_move)

    p = agt_sub.add_parser("edit", help="Update agent name or color")
    p.add_argument("identifier", help="Agent ID or name")
    p.add_argument("--name", help="New name")
    p.add_argument("--color", help="New tab color (hex)")
    p.set_defaults(func=cmd_agent_edit)

    # -- terminal -----------------------------------------------------------
    trm = sub.add_parser("terminal", aliases=["t", "term"],
                         help="Terminal management")
    trm.set_defaults(func=None, _sub_parser=trm)
    trm_sub = trm.add_subparsers(dest="terminal_cmd")

    p = trm_sub.add_parser("add", help="Create a terminal")
    p.add_argument("name", help="Terminal name")
    p.add_argument("-p", "--parent", help="Parent agent ID or name")
    p.add_argument("-g", "--group", help="Group (if no parent)")
    p.add_argument("-c", "--command", help="Boot command")
    p.add_argument("-d", "--directory", help="Working directory")
    p.add_argument("--profile", help="iTerm2 profile")
    p.add_argument("--color", help="Tab color (hex)")
    p.set_defaults(func=cmd_terminal_add)

    p = trm_sub.add_parser("remove", aliases=["rm"],
                           help="Remove a terminal")
    p.add_argument("identifier", help="Terminal ID or name")
    p.set_defaults(func=cmd_terminal_remove)

    p = trm_sub.add_parser("reparent", help="Reparent a terminal")
    p.add_argument("identifier", help="Terminal ID or name")
    p.add_argument("-p", "--parent", help="New parent agent ID or name")
    p.add_argument("--detach", action="store_true",
                   help="Detach from parent")
    p.set_defaults(func=cmd_terminal_reparent)

    # -- send ---------------------------------------------------------------
    p = sub.add_parser("send", help="Send text to a session")
    p.add_argument("text", help="Text to send")
    p.add_argument("-t", "--to",  dest="identifier", default="",
                   help="Target agent/terminal ID or name "
                        "(auto-detected if in a Loom session)")
    p.add_argument("-w", "--wait", action="store_true",
                   help="Wait until the agent finishes (polls every 2s)")
    p.set_defaults(func=cmd_send)

    # -- broadcast ----------------------------------------------------------
    p = sub.add_parser("broadcast", aliases=["bc"],
                       help="Broadcast text to a group")
    p.add_argument("group", help="Group name")
    p.add_argument("text", help="Text to broadcast")
    p.set_defaults(func=cmd_broadcast)

    # -- worktree -----------------------------------------------------------
    wt = sub.add_parser("worktree", aliases=["wt"],
                        help="Git worktree management")
    wt.set_defaults(func=None, _sub_parser=wt)
    wt_sub = wt.add_subparsers(dest="worktree_cmd")

    p = wt_sub.add_parser("create", help="Create worktree for agent")
    p.add_argument("identifier", help="Agent ID or name")
    p.add_argument("--relaunch", action="store_true",
                   help="Relaunch agent in worktree")
    p.set_defaults(func=cmd_worktree_create)

    p = wt_sub.add_parser("remove", aliases=["rm"],
                           help="Remove worktree")
    p.add_argument("identifier", help="Agent ID or name")
    p.add_argument("--relaunch", action="store_true",
                   help="Relaunch agent after removal")
    p.set_defaults(func=cmd_worktree_remove)

    p = wt_sub.add_parser("checkpoint", aliases=["cp"],
                           help="Create checkpoint commit")
    p.add_argument("identifier", help="Agent ID or name")
    p.set_defaults(func=cmd_worktree_checkpoint)

    p = wt_sub.add_parser("history", aliases=["log"],
                           help="Show checkpoint history")
    p.add_argument("identifier", help="Agent ID or name")
    p.set_defaults(func=cmd_worktree_history)

    p = wt_sub.add_parser("rollback", help="Rollback to checkpoint")
    p.add_argument("identifier", help="Agent ID or name")
    p.add_argument("sha", help="Commit SHA to rollback to")
    p.set_defaults(func=cmd_worktree_rollback)

    # -- dispatch -----------------------------------------------------------
    p = sub.add_parser("dispatch", aliases=["d"],
                       help="Create agent from template and send prompt")
    p.add_argument("description", help="Task description (sent as prompt)")
    p.add_argument("-t", "--template", help="Template name")
    p.add_argument("-g", "--group",
                   help="Target group (auto-detected if in a Loom session)")
    p.add_argument("-n", "--name", help="Agent name override")
    p.add_argument("-c", "--command", help="Boot command override")
    p.add_argument("-d", "--directory", help="Working directory override")
    p.add_argument("-v", "--var", nargs="+", metavar="KEY=VALUE",
                   help="Template variables (e.g., -v TEST_COMMAND='pytest')")
    p.add_argument("-w", "--wait", action="store_true",
                   help="Wait for the agent to finish")
    p.add_argument("--no-prompt", action="store_true",
                   help="Create agent but don't send a prompt")
    p.set_defaults(func=cmd_dispatch)

    # -- template -----------------------------------------------------------
    tmpl = sub.add_parser("template", aliases=["tpl"],
                          help="Template management")
    tmpl.set_defaults(func=None, _sub_parser=tmpl)
    tmpl_sub = tmpl.add_subparsers(dest="template_cmd")

    p = tmpl_sub.add_parser("list", aliases=["ls"],
                            help="List available templates")
    p.set_defaults(func=cmd_template_list)

    p = tmpl_sub.add_parser("show", help="Show template contents")
    p.add_argument("name", help="Template name")
    p.set_defaults(func=cmd_template_show)

    p = tmpl_sub.add_parser("create", help="Create a starter template")
    p.add_argument("name", help="Template name")
    p.set_defaults(func=cmd_template_create)

    # -- board --------------------------------------------------------------
    brd = sub.add_parser("board", aliases=["bd"],
                         help="Task board management")
    brd.set_defaults(func=cmd_board_list, _sub_parser=brd)
    brd_sub = brd.add_subparsers(dest="board_cmd")

    p = brd_sub.add_parser("list", aliases=["ls"],
                            help="List tasks by lane")
    p.add_argument("-l", "--lane", help="Filter by lane name")
    p.set_defaults(func=cmd_board_list)

    p = brd_sub.add_parser("add", help="Add a task")
    p.add_argument("title", help="Task title")
    p.add_argument("-l", "--lane", help="Target lane (default: first lane)")
    p.set_defaults(func=cmd_board_add)

    p = brd_sub.add_parser("move", help="Move a task to a lane")
    p.add_argument("identifier", help="Task ID prefix or title")
    p.add_argument("-l", "--lane", required=True,
                   help="Target lane")
    p.set_defaults(func=cmd_board_move)

    p = brd_sub.add_parser("remove", aliases=["rm"],
                            help="Remove a task")
    p.add_argument("identifier", help="Task ID prefix or title")
    p.set_defaults(func=cmd_board_remove)

    p = brd_sub.add_parser("lanes", help="List lanes")
    p.set_defaults(func=cmd_board_lanes)

    # -- logs ---------------------------------------------------------------
    p = sub.add_parser("logs", help="Tail daemon log")
    p.add_argument("-f", "--follow", action="store_true",
                   help="Follow log output")
    p.set_defaults(func=cmd_logs)

    return parser


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = build_parser()
    args = parser.parse_args()

    if not hasattr(args, "func") or args.func is None:
        # Show help for the subcommand (e.g. "loom agent") or top-level
        sub_parser = getattr(args, "_sub_parser", None)
        (sub_parser or parser).print_help()
        sys.exit(1)

    args.func(args)


if __name__ == "__main__":
    main()
