def cmd_status(args):
    state_data = get_state(args.port)

    if args.identifier:
        cell = resolve_cell(state_data, args.identifier)
        agents = state_data.get("agents", {})
        children = state_data.get("children", {})
        if args.json:
            print(json.dumps(cell, indent=2))
        else:
            print(format_agent_detail(cell, children, agents))
    else:
        # Default: filter to current window unless --all
        window_id = None
        if not args.all and not args.group:
            ctx_cell, _, _ = detect_context(state_data)
            if ctx_cell:
                window_id = ctx_cell.get("window_id", "")
        if args.json:
            print(json.dumps(state_data, indent=2))
        else:
            print(format_status_table(state_data, args.group,
                                      window_id))


