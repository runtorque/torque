#!/usr/bin/env python3
"""Read-only gh fixture for github-settings-live.spec.ts.

Prepend this directory to PATH only in a disposable daemon, with
TORQUE_GITHUB_SETTINGS_FIXTURE=1. No command reaches GitHub.
"""
import json
import os
import sys

if os.environ.get('TORQUE_GITHUB_SETTINGS_FIXTURE') != '1':
    sys.exit('This fixture requires TORQUE_GITHUB_SETTINGS_FIXTURE=1.')
args = sys.argv[1:]
project = {'title': 'Fixture delivery', 'number': 7, 'id': 'PVT_fixture_7', 'owner': {'login': 'fixture-team'}}
if args == ['--version']:
    print('gh version 2.0.0 (read-only Torque fixture)')
elif args == ['auth', 'status']:
    print("Logged in to github.com as fixture-user. Token scopes: 'repo', 'project'")
elif args[:2] == ['repo', 'view']:
    repo = args[2] if len(args) > 2 and args[2] != '--json' else 'fixture/current'
    print(json.dumps({'nameWithOwner': repo, 'url': 'https://github.com/' + repo}))
elif args[:2] == ['project', 'list']:
    print(json.dumps({'projects': [project]}))
elif args[:2] == ['project', 'view']:
    print(json.dumps(project))
elif args[:2] == ['project', 'field-list']:
    print(json.dumps({'fields': [{'id': 'F1', 'name': 'Status', 'options': [
        {'id': 'S1', 'name': 'Backlog'}, {'id': 'S2', 'name': 'Todo'},
        {'id': 'S3', 'name': 'In progress'}, {'id': 'S4', 'name': 'Done'},
    ]}]}))
else:
    print('Read-only GitHub fixture rejected unsupported command.', file=sys.stderr)
    sys.exit(2)
